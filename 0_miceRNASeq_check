# ============================================================
# CHECK: metadata vs count matrix
# ============================================================

metadata_list <- list(
  IST   = metadata_IST,
  MTK25 = metadata_MTK25,
  MTK26 = metadata_MTK26,
  POE   = metadata_POE,
  NT    = metadata_NT
)

for (st in names(metadata_list)) {
  
  cat("\n============================\n")
  cat("CHECK:", st, "\n")
  cat("============================\n")
  
  # file counts
  count_file <- list.files(
    file.path(base_dir, st),
    pattern = "\\.tabular$",
    full.names = TRUE
  )
  
  counts <- read.delim(
    count_file,
    header = TRUE,
    sep = "\t",
    check.names = FALSE,
    stringsAsFactors = FALSE
  )
  
  # nomi tecnici delle colonne
  count_names <- colnames(counts)[-1]
  
  # estraiamo il sample ID dall'inizio del nome tecnico
  sample_names <- sub(
    "_MKRN.*$",
    "",
    count_names
  )
  
  metadata_names <- metadata_list[[st]]$sample_id
  
  cat("Count matrix samples:\n")
  print(sample_names)
  
  cat("\nMetadata samples:\n")
  print(metadata_names)
  
  cat("\nMetadata samples not found in counts:\n")
  print(setdiff(metadata_names, sample_names))
  
  cat("\nCount samples not found in metadata:\n")
  print(setdiff(sample_names, metadata_names))
  
  cat("\nNumber of count samples:", length(sample_names), "\n")
  cat("Number of metadata rows:", nrow(metadata_list[[st]]), "\n")
}
