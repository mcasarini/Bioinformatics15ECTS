# MCPcounter in TCGA-PRAD
How does the tumour microenvironment composition (immune + stromal) in prostate cancer relate to tumour aggressiveness and FOLH1 expression? 

## set
base_dir <- "C:/Users/Martina/Desktop/TCGA"
out_dir <- file.path(base_dir, "results")
dir.create(out_dir,showWarnings = FALSE, recursive = TRUE)

## packages
library(SummarizedExperiment)
library(immunedeconv)
library(dplyr)
library(ggpubr)
library(ggplot2)
library(limma)
library(pheatmap)
library(openxlsx)
library(RColorBrewer)

## load & check raw data
rds_file <- file.path(base_dir, "TCGA_PRAD_clinical.rds")
prad <- readRDS(rds_file)
class(prad)
dim(prad)
table(colData(prad)$sample_type)
assayNames(prad)
summary(assay(prad, "fpkm_uq_unstrand")[,1])

## verify FOLH1 presence
rd <- as.data.frame(rowData(prad))
rd$symbol <- rd$gene_name
which(rd$symbol == "FOLH1")
sum(rd$symbol == "FOLH1", na.rm = TRUE)

## extract & clean expression matrix
expr <- assay(prad, "fpkm_uq_unstrand")
genes <- rowData(prad)$gene_name
rownames(expr) <- genes
expr <- expr[rownames(expr) != "", ]
expr <- expr[!is.na(rownames(expr)), ]
expr <- expr[!duplicated(rownames(expr)), ]
expr <- as.matrix(expr)
storage.mode(expr) <- "double"
sample_info <- as.data.frame(colData(prad), stringsAsFactors = FALSE)
gene_info <- as.data.frame(rowData(prad))
sample_info <- data.frame(lapply(sample_info, function(x) {
  if (is.list(x)) {
    return(as.character(x))
  } else {
    return(x)
  }
}), check.names = FALSE)

## MCP counter: tumour microenvironment of TCG-PRAD
result <- deconvolute(expr, method = "mcp_counter")
result_df <- as.data.frame(result)
rownames(result_df) <- result_df$cell_type
result_df$cell_type <- NULL
result_mat <- as.matrix(result_df)
storage.mode(result_mat) <- "double"
print(class(result_mat))
print(dim(result_mat))
print(rownames(result_mat))
any(is.na(result_mat))
any(is.infinite(result_mat))
qc_expr_head <- head(expr[,1:5])
qc_expr_rows <- head(rownames(expr))
qc_result_head <- head(result_mat)
qc_result_rows <- rownames(result_mat)
qc_sample_info <- head(sample_info)

