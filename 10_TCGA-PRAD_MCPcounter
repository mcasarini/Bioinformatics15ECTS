## MCP counter: tumor microenvironment of PRAD vs Normal
# group
group <- sample_info$sample_type
names(group) <- sample_info$barcode
group2 <- group[colnames(result_mat)]
table(group2, useNA = "ifany")
keep <- group2 %in% c("Primary Tumor", "Solid Tissue Normal")
result_mat2 <- result_mat[, keep]
group2 <- group2[keep]
group2 <- droplevels(factor(group2))
table(group2)
stopifnot(length(unique(group2)) == 2)

# statistics (Wilcoxon)
stats_df <- do.call(rbind, lapply(rownames(result_mat2), function(cell) {
  x <- result_mat2[cell, ]
  p <- wilcox.test(x ~ group2)$p.value
  data.frame(
    CellType = cell,
    p.value = p,
    Tumor_mean = mean(x[group2 == "Primary Tumor"], na.rm = TRUE),
    Normal_mean = mean(x[group2 == "Solid Tissue Normal"], na.rm = TRUE))}))

# FDR correction
stats_df$FDR <- p.adjust(stats_df$p.value, method = "fdr")

# direction
stats_df$Direction <- ifelse(
  stats_df$Tumor_mean > stats_df$Normal_mean,
  "Enriched in Tumor",
  "Enriched in Normal")

# significance
stats_df$Significance <- case_when(
  stats_df$FDR < 0.001 ~ "***",
  stats_df$FDR < 0.01  ~ "**",
  stats_df$FDR < 0.05  ~ "*",
  TRUE ~ "ns")
stats_df <- stats_df[order(stats_df$FDR), ]
sig_df <- subset(stats_df, FDR < 0.05)
sig_strict <- subset(stats_df, FDR < 0.01)

# barplot
stats_df$CellType <- factor(stats_df$CellType, levels = stats_df$CellType)
pdf(file.path(out_dir, "12_TCGA-PRAD_MCPcounter_TumorvsNormal_barplot.pdf"),
    width = 10, height = 7)
ggplot(stats_df, aes(x = CellType, y = -log10(FDR), fill = Direction)) +
  geom_col() +
  coord_flip() +
  scale_fill_manual(values = c(
    "Enriched in Tumor" = "#D73027",
    "Enriched in Normal" = "#4575B4")) +
  theme_classic(base_size = 14) +
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold"),
    plot.margin = margin(10, 15, 10, 15)) +
  labs(
    title = "TCGA-PRAD MCP-counter\nTumor vs Normal Immune Infiltration",
    x = "",
    y = "-log10(FDR)")
dev.off()

# summary
wb <- createWorkbook()
addWorksheet(wb, "Stats_Full")
writeData(wb, "Stats_Full", stats_df)
addWorksheet(wb, "Sig_FDR_0.05")
writeData(wb, "Sig_FDR_0.05", sig_df)
addWorksheet(wb, "Sig_FDR_0.01")
writeData(wb, "Sig_FDR_0.01", sig_strict)
mcp_export <- data.frame(
  CellType = rownames(result_mat2),
  result_mat2,
  check.names = FALSE)
addWorksheet(wb, "MCP_Scores")
writeData(wb, "MCP_Scores", mcp_export)
addWorksheet(wb, "Sample_Group")
writeData(wb, "Sample_Group",
          data.frame(Sample = names(group2), Group = group2))
addWorksheet(wb, "QC")
writeData(wb, "QC", data.frame(
  n_tumor = sum(group2 == "Primary Tumor"),
  n_normal = sum(group2 == "Solid Tissue Normal"),
  n_samples = length(group2),
  n_cell_types = nrow(result_mat2)))
saveWorkbook(
  wb,
  file.path(out_dir, "12_TCGA-PRAD_MCPcounter_TumorvsNormal_summary.xlsx"),
  overwrite = TRUE)

## FOLH1 vs MCP-counter
folh1 <- expr["FOLH1", ]
cor_folh1 <- lapply(rownames(result_mat), function(ct){
  ct_vals <- result_mat[ct, ]
  test <- cor.test(folh1, ct_vals, method = "spearman")
  data.frame(
    CellType = ct,
    rho = test$estimate,
    p = test$p.value)})
cor_folh1 <- do.call(rbind, cor_folh1)
cor_folh1$FDR <- p.adjust(cor_folh1$p, method="BH")
cor_folh1 <- cor_folh1[order(abs(cor_folh1$rho), decreasing=TRUE), ]
