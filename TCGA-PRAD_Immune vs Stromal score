## theme
theme_nature <- function() {
  theme_classic(base_size = 14) +
    theme(
      text = element_text(family = "Arial"),
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      axis.title = element_text(face = "bold"),
      axis.text = element_text(color = "black"),
      axis.line = element_line(linewidth = 0.6),
      axis.ticks = element_line(linewidth = 0.6),
      legend.position = "right")}

## load & check raw data
rds_file <- file.path(base_dir, "TCGA_PRAD_clinical.rds")
prad <- readRDS(rds_file)
class(prad)
dim(prad)
table(colData(prad)$sample_type)
assayNames(prad)
summary(assay(prad, "fpkm_uq_unstrand")[,1])

## verify FOLH1 presence
rd <- as.data.frame(rowData(prad))
rd$symbol <- rd$gene_name
which(rd$symbol == "FOLH1")
sum(rd$symbol == "FOLH1", na.rm = TRUE)

## extract & clean expression matrix
expr <- assay(prad, "fpkm_uq_unstrand")
genes <- rowData(prad)$gene_name
rownames(expr) <- genes
expr <- expr[rownames(expr) != "", ]
expr <- expr[!is.na(rownames(expr)), ]
expr <- expr[!duplicated(rownames(expr)), ]
expr <- as.matrix(expr)
storage.mode(expr) <- "double"
sample_info <- as.data.frame(colData(prad), stringsAsFactors = FALSE)
gene_info <- as.data.frame(rowData(prad))
sample_info <- data.frame(lapply(sample_info, function(x) {
  if (is.list(x)) {
    return(as.character(x))
  } else {
    return(x)
  }
}), check.names = FALSE)

## immune vs stromal score
group <- sample_info$sample_type
names(group) <- sample_info$barcode
group <- group[colnames(result_mat)]
keep <- group %in% c("Primary Tumor", "Solid Tissue Normal")
expr_mat <- result_mat[, keep]
group <- droplevels(factor(group[keep]))
immune_score <- colMeans(expr_mat[c("T cell","NK cell","cytotoxicity score"), ], na.rm = TRUE)
stromal_score <- colMeans(expr_mat[c("Cancer associated fibroblast","Endothelial cell"), ], na.rm = TRUE)
df2 <- data.frame(
  Sample = names(immune_score),
  Immune = immune_score,
  Stromal = stromal_score,
  Group = group)
pdf(file.path(out_dir, "15_TCGA_PRAD_ImmunevsStromal_plot.pdf"), 7, 6)
ggboxplot(df2,
          x = "Group",
          y = "Immune",
          fill = "Group",
          palette = c("#4575B4", "#D73027"),
          add = "jitter",
          alpha = 0.4,
          linewidth = 0.5) +
  stat_compare_means(method = "wilcox.test", label = "p.signif") +
  labs(
    title = "Immune Infiltration in TCGA-PRAD",
    x = "",
    y = "Immune Score"
  ) +
  theme_nature()
dev.off()

## hot vs cold tumour
immune_total <- immune_score
cutoff <- median(immune_total, na.rm = TRUE)
df2$ImmuneState <- ifelse(immune_total > cutoff, "Hot", "Cold")
pdf(file.path(out_dir, "15_TCGA-PRAD_HotvsCold_plot.pdf"), 8, 8)
ggplot(df2, aes(x = ImmuneState, fill = ImmuneState)) +
  geom_bar(width = 0.6) +
  geom_text(stat = "count",
            aes(label = ..count..),
            vjust = -0.5,
            size = 5) +
  scale_fill_manual(values = c(
    "Hot" = "#D73027",
    "Cold" = "#4575B4")) +
  labs(
    title = "Immune Phenotypes in TCGA-PRAD",
    x = "",
    y = "Number of Samples") +
  theme_nature() +
  theme(legend.position = "none")
dev.off()

## Gleason score 
samples <- colnames(expr_mat)
group <- sample_info$sample_type
names(group) <- sample_info$barcode
gleason <- sample_info$gleason_score
names(gleason) <- sample_info$barcode
group2 <- group[samples]
gleason2 <- gleason[samples]
immune_total <- immune_total[samples]
df3 <- data.frame(
  Sample = samples,
  Immune = immune_total,
  Gleason = gleason2,
  Group = group2)
df3 <- df3[!is.na(df3$Gleason), ]
pdf(file.path(out_dir, "15_TCGA-PRAD_GleasonScore_plot.pdf"), 7, 6)
ggscatter(df3,
          x = "Gleason",
          y = "Immune",
          add = "reg.line",
          conf.int = TRUE,
          cor.coef = TRUE,
          cor.method = "spearman",
          color = "steelblue",
          size = 2) +
  labs(
    title = "Immune Infiltration vs Gleason Score",
    x = "Gleason Score",
    y = "Immune Score") +
  theme_nature()
dev.off()

