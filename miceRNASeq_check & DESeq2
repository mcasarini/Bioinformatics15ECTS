# ============================================================
# 20. DEFINITIVE DE LISTS
# ============================================================

dir.create(
  "DE_final",
  showWarnings = FALSE
)

dir.create(
  "DE_final/padj_0.05",
  showWarnings = FALSE
)

dir.create(
  "DE_final/padj_0.05_LFC1",
  showWarnings = FALSE
)


DE_padj05 <- list()

DE_padj05_LFC1 <- list()


for (comparison in names(results_list)) {
  
  df <- as.data.frame(
    results_list[[comparison]]
  )
  
  df$gene_id <- rownames(df)
  
  
  # ----------------------------------------------------------
  # padj < 0.05
  # ----------------------------------------------------------
  
  de <- df[
    !is.na(df$padj) &
      df$padj < padj_cutoff,
    ,
    drop = FALSE
  ]
  
  
  # ----------------------------------------------------------
  # padj < 0.05 AND |LFC| >= 1
  # ----------------------------------------------------------
  
  de_lfc <- df[
    !is.na(df$padj) &
      !is.na(df$log2FoldChange) &
      df$padj < padj_cutoff &
      abs(df$log2FoldChange) >= lfc_cutoff,
    ,
    drop = FALSE
  ]
  
  
  # ----------------------------------------------------------
  # Direction
  # ----------------------------------------------------------
  
  if (nrow(de) > 0) {
    
    de$direction <- ifelse(
      de$log2FoldChange > 0,
      "up",
      ifelse(
        de$log2FoldChange < 0,
        "down",
        "zero"
      )
    )
  }
  
  
  if (nrow(de_lfc) > 0) {
    
    de_lfc$direction <- ifelse(
      de_lfc$log2FoldChange > 0,
      "up",
      ifelse(
        de_lfc$log2FoldChange < 0,
        "down",
        "zero"
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Sort
  # ----------------------------------------------------------
  
  if (nrow(de) > 0) {
    
    de <- de[
      order(
        de$padj,
        -abs(de$log2FoldChange)
      ),
      ,
      drop = FALSE
    ]
  }
  
  
  if (nrow(de_lfc) > 0) {
    
    de_lfc <- de_lfc[
      order(
        de_lfc$padj,
        -abs(de_lfc$log2FoldChange)
      ),
      ,
      drop = FALSE
    ]
  }
  
  
  # ----------------------------------------------------------
  # Store
  # ----------------------------------------------------------
  
  DE_padj05[[comparison]] <- de
  
  DE_padj05_LFC1[[comparison]] <- de_lfc
  
  
  # ----------------------------------------------------------
  # Save
  # ----------------------------------------------------------
  
  write.csv(
    de,
    file.path(
      "DE_final/padj_0.05",
      paste0(
        comparison,
        "_DE_padj05.csv"
      )
    ),
    row.names = FALSE
  )
  
  
  write.csv(
    de_lfc,
    file.path(
      "DE_final/padj_0.05_LFC1",
      paste0(
        comparison,
        "_DE_padj05_LFC1.csv"
      )
    ),
    row.names = FALSE
  )
}


