# ============================================================
# 4. HELPER FUNCTION
#
# Reverse an already calculated contrast.
#
# Example:
#
# KO vs WT
#
# becomes
#
# WT vs KO
#
# log2FC and statistic change sign.
# p-value and padj remain identical.
# ============================================================

reverse_result <- function(res) {
  
  res_reversed <- res
  
  if ("log2FoldChange" %in% names(res_reversed)) {
    
    res_reversed$log2FoldChange <-
      -res_reversed$log2FoldChange
  }
  
  if ("stat" %in% names(res_reversed)) {
    
    res_reversed$stat <-
      -res_reversed$stat
  }
  
  attr(
    res_reversed,
    "reversed_contrast"
  ) <- TRUE
  
  res_reversed
}


