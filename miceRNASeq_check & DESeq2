# 21. FINAL DE SUMMARY
# ============================================================

DE_summary <- do.call(
  rbind,
  lapply(
    names(results_list),
    function(comparison) {
      
      df <- as.data.frame(
        results_list[[comparison]]
      )
      
      sig <- (
        !is.na(df$padj) &
          df$padj < padj_cutoff
      )
      
      sig_lfc <- (
        sig &
          !is.na(df$log2FoldChange) &
          abs(df$log2FoldChange) >= lfc_cutoff
      )
      
      up <- (
        sig_lfc &
          df$log2FoldChange >= lfc_cutoff
      )
      
      down <- (
        sig_lfc &
          df$log2FoldChange <= -lfc_cutoff
      )
      
      data.frame(
        
        comparison = comparison,
        
        total_DE_padj05 =
          sum(sig),
        
        total_DE_padj05_LFC1 =
          sum(sig_lfc),
        
        upregulated_LFC1 =
          sum(up),
        
        downregulated_LFC1 =
          sum(down),
        
        padj_cutoff =
          padj_cutoff,
        
        log2FC_cutoff =
          lfc_cutoff,
        
        stringsAsFactors = FALSE
      )
    }
  )
)

