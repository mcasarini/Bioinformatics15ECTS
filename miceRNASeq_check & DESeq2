# ============================================================
# 14. RESULTS QC
# ============================================================

padj_cutoff <- 0.05
lfc_cutoff <- 1


qc_results <- do.call(
  rbind,
  lapply(
    names(results_list),
    function(comparison) {
      
      res <- as.data.frame(
        results_list[[comparison]]
      )
      
      sig <- (
        !is.na(res$padj) &
          res$padj < padj_cutoff
      )
      
      sig_lfc <- (
        sig &
          !is.na(res$log2FoldChange) &
          abs(res$log2FoldChange) >= lfc_cutoff
      )
      
      up <- (
        sig_lfc &
          res$log2FoldChange > 0
      )
      
      down <- (
        sig_lfc &
          res$log2FoldChange < 0
      )
      
      data.frame(
        
        comparison = comparison,
        
        total_genes = nrow(res),
        
        tested_genes =
          sum(!is.na(res$pvalue)),
        
        nonNA_padj =
          sum(!is.na(res$padj)),
        
        NA_padj =
          sum(is.na(res$padj)),
        
        DE_padj_0.05 =
          sum(sig),
        
        DE_padj_0.05_LFC1 =
          sum(sig_lfc),
        
        up_LFC1 =
          sum(up),
        
        down_LFC1 =
          sum(down),
        
        min_log2FC =
          ifelse(
            all(is.na(res$log2FoldChange)),
            NA,
            min(
              res$log2FoldChange,
              na.rm = TRUE
            )
          ),
        
        max_log2FC =
          ifelse(
            all(is.na(res$log2FoldChange)),
            NA,
            max(
              res$log2FoldChange,
              na.rm = TRUE
            )
          ),
        
        stringsAsFactors = FALSE
      )
    }
