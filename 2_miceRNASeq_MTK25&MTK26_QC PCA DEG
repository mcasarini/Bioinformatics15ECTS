# ============================================================
# TREND FUNCTION
# ============================================================

run_biomarker_trend <- function(
    deg_table,
    biomarkers,
    comparison_name,
    output_dir
){
  
  dir.create(
    output_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  biomarker_df <- deg_table %>%
    
    filter(
      toupper(SYMBOL) %in%
        toupper(biomarkers)
    ) %>%
    
    filter(
      !is.na(log2FoldChange)
    ) %>%
    
    mutate(
      
      Trend = case_when(
        
        !is.na(pvalue) &
          pvalue < 0.05 &
          log2FoldChange > 0 ~
          
          "Higher",
        
        !is.na(pvalue) &
          pvalue < 0.05 &
          log2FoldChange < 0 ~
          
          "Lower",
        
        TRUE ~
          
          "No Trend"
      )
    ) %>%
    
    arrange(
      pvalue
    )
  
  # ----------------------------------------------------------
  # SAVE FULL TABLE
  # ----------------------------------------------------------
  
  write.csv(
    
    biomarker_df,
    
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Biomarkers.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  # ----------------------------------------------------------
  # SAVE TREND GENES ONLY
  # ----------------------------------------------------------
  
  trend_only <- biomarker_df %>%
    
    filter(
      Trend != "No Trend"
    )
  
  write.csv(
    
    trend_only,
    
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Trend_Genes.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  # ----------------------------------------------------------
  # BARPLOT
  # ----------------------------------------------------------
  
  p <- ggplot(
    
    biomarker_df,
    
    aes(
      
      x = reorder(
        SYMBOL,
        log2FoldChange
      ),
      
      y = log2FoldChange,
      
      fill = Trend
    )
    
  ) +
    
    geom_col(
      width = 0.75
    ) +
    
    coord_flip() +
    
    geom_hline(
      yintercept = 0,
      linewidth = 0.5
    ) +
    
    scale_fill_manual(
      
      values = c(
        
        "Higher" = "#D62728",
        
        "Lower" = "#1F77B4",
        
        "No Trend" = "grey75"
      )
    ) +
    
    theme_classic(
      base_size = 14
    ) +
    
    labs(
      
      title =
        comparison_name,
      
      x = NULL,
      
      y =
        "log2 Fold Change"
    ) +
    
    theme(
      
      legend.title =
        element_blank(),
      
      plot.title =
        element_text(
          face = "bold",
          hjust = 0.5
        )
    )
  
  ggsave(
    
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Biomarker_Trends.png"
      )
    ),
    
    p,
    
