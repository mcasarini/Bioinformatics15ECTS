# ====================================================================
# GSEA DOTPLOT FUNCTION
# ====================================================================
#
# IMPORTANT FIX FOR CROWDED PLOTS:
#
# 1. showCategory = 12 instead of 20
# 2. much taller PNG
# 3. dynamic height according to number of pathways
# 4. smaller y-axis font
# 5. larger plot margins
# 6. separate positive/negative NES using facet
#
# ====================================================================

save_gsea_dotplot <- function(
    gsea_obj,
    csv_file,
    png_file,
    title_text,
    show_n = 12) {
  
  if (
    is.null(
      gsea_obj
    )
  ) {
    
    return(
      invisible(NULL)
    )
  }
  
  df <- as.data.frame(
    gsea_obj
  )
  
  if (
    nrow(df) == 0
  ) {
    
    return(
      invisible(NULL)
    )
  }
  
  # --------------------------------------------------------------
  # SAVE COMPLETE GSEA TABLE
  # --------------------------------------------------------------
  
  write.csv(
    df,
    csv_file,
    row.names = FALSE
  )
  
  # --------------------------------------------------------------
  # NUMBER OF TERMS
  # --------------------------------------------------------------
  
  n_show <- min(
    show_n,
    nrow(df)
  )
  
  # --------------------------------------------------------------
  # DOTPLOT
  # --------------------------------------------------------------
  
  p <- dotplot(
    gsea_obj,
    showCategory = n_show,
    split = ".sign"
  ) +
    
    facet_grid(
      . ~ .sign
    ) +
    
    ggtitle(
      title_text
    ) +
    
    theme_nature(
      base_size = 13
    ) +
    
    theme(
      
      plot.title = element_text(
        face = "bold",
        hjust = 0.5,
        size = 17
      ),
      
      axis.text.y = element_text(
        size = 8,
        colour = "black",
        lineheight = 0.85
      ),
      
      axis.text.x = element_text(
        size = 9,
        colour = "black"
      ),
      
      axis.title.x = element_text(
        size = 11,
        face = "bold"
      ),
      
      axis.title.y = element_text(
        size = 11,
        face = "bold"
      ),
      
      strip.text = element_text(
        size = 11,
        face = "bold"
      ),
      
      legend.text = element_text(
        size = 9
      ),
      
      plot.margin = margin(
        t = 15,
        r = 25,
        b = 15,
        l = 30
      )
    )
  
  # --------------------------------------------------------------
  # DYNAMIC HEIGHT
  # --------------------------------------------------------------
  #
  # Approximately 0.55 inch per pathway.
  #
  # This prevents y-axis labels from overlapping.
  #
  
  plot_height <- max(
    8,
    0.55 * n_show + 4
  )
  
  # --------------------------------------------------------------
  # SAVE
  # --------------------------------------------------------------
  
  ggsave(
    filename = png_file,
    plot = p,
    
    width = 13,
    
    height = plot_height,
    
    units = "in",
    
    dpi = 300,
    
    bg = "white"
  )
  
  invisible(
    gsea_obj
  )
}

