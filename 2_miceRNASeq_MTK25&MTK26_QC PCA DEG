calc_group_correlations <- function(
    group_name) {
  
  samples_in_group <-
    rownames(
      sample_info
    )[
      sample_info$condition ==
        group_name
    ]
  
  folh1_rows <-
    get_symbol_rows(
      "FOLH1"
    )
  
  folh1_expr_group <-
    as.numeric(
      colMeans(
        vst_mat[
          folh1_rows,
          samples_in_group,
          drop = FALSE
        ],
        na.rm = TRUE
      )
    )
  
  res <- lapply(
    available_biomarkers[
      available_biomarkers !=
        "FOLH1"
    ],
    
    function(g) {
      
      rows <- get_symbol_rows(
        g
      )
      
      x <- as.numeric(
        colMeans(
          vst_mat[
            rows,
            samples_in_group,
            drop = FALSE
          ],
          na.rm = TRUE
        )
      )
      
      ok <-
        is.finite(x) &
        is.finite(
          folh1_expr_group
        )
      
      if (
        sum(ok) < 3
      ) {
        
        return(
          data.frame(
            gene = g,
            group = group_name,
            cor = NA_real_,
            p.value = NA_real_,
            n = sum(ok),
            stringsAsFactors = FALSE
          )
        )
      }
      
      ct <- suppressWarnings(
        cor.test(
          x[ok],
          folh1_expr_group[ok],
          method = "spearman",
          exact = FALSE
        )
      )
      
      data.frame(
        gene = g,
        group = group_name,
        cor = unname(
          ct$estimate
        ),
        p.value = ct$p.value,
        n = sum(ok),
        stringsAsFactors = FALSE
      )
    }
  ) %>%
    
    bind_rows()
  
  res$p.adj <-
    p.adjust(
      res$p.value,
      method = "BH"
    )
  
  res %>%
    arrange(
      desc(cor)
    )
}

