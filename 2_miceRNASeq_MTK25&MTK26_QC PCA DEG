plot_deg_heatmap <- function(
    gene_table,
    mat,
    sample_info,
    filename,
    title_text,
    scale_rows = TRUE) {
  
  genes_use <- intersect(
    gene_table$ENSEMBL,
    rownames(
      mat
    )
  )
  
  if (
    length(genes_use) < 2
  ) {
    return(NULL)
  }
  
  hm_mat <- mat[
    genes_use,
    ,
    drop = FALSE
  ]
  
  gene_symbols <-
    gene_table$SYMBOL[
      match(
        rownames(
          hm_mat
        ),
        gene_table$ENSEMBL
      )
    ]
  
  gene_symbols[
    is.na(
      gene_symbols
    ) |
      gene_symbols == ""
  ] <-
    rownames(
      hm_mat
    )[
      is.na(
        gene_symbols
      ) |
        gene_symbols == ""
    ]
  
  rownames(
    hm_mat
  ) <-
    make.unique(
      gene_symbols
    )
  
  ann_col <- data.frame(
    condition = sample_info[
      colnames(
        hm_mat
      ),
      "condition"
    ],
    
    row.names = colnames(
      hm_mat
    )
  )
  
  pheatmap(
    hm_mat,
    
    scale = if (
      scale_rows
    ) {
      "row"
    } else {
      "none"
    },
    
    clustering_distance_rows = "euclidean",
    
    clustering_distance_cols = "euclidean",
    
    clustering_method = "complete",
    
    annotation_col = ann_col,
    
    labels_col = sample_info[
      colnames(
        hm_mat
      ),
      "sample_short10"
    ],
    
    show_colnames = TRUE,
    show_rownames = TRUE,
    
    fontsize_row = ifelse(
      nrow(
        hm_mat
      ) > 80,
      5,
      7
    ),
    
    fontsize_col = 8,
    
    main = paste0(
      title_text,
      " (",
      plot_label,
      ")"
    ),
    
    filename = filename,
    
    width = 10,
    height = 12
  )
}

