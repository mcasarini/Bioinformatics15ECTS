plot_group_box <- function(
    df,
    gene,
    ylab = "VST expression") {
  
  wilcox_res <- tryCatch(
    wilcox.test(
      expr ~ condition,
      data = df
    ),
    error = function(e) NULL
  )
  
  p_label <- if (
    !is.null(wilcox_res)
  ) {
    
    paste0(
      "Wilcoxon p = ",
      signif(
        wilcox_res$p.value,
        3
      )
    )
    
  } else {
    
    "Wilcoxon p = NA"
    
  }
  
  y_range <- range(
    df$expr,
    na.rm = TRUE
  )
  
  y_diff <- diff(
    y_range
  )
  
  if (
    y_diff == 0
  ) {
    y_diff <- 0.5
  }
  
  y_pad <- 0.18 * y_diff
  
  y_pos <- y_range[2] +
    0.45 * y_pad
  
  p <- ggplot(
    df,
    aes(
      x = condition,
      y = expr,
      fill = condition
    )
  ) +
    
    geom_boxplot(
      width = 0.62,
      outlier.shape = NA,
      alpha = 0.9,
      linewidth = 0.9
    ) +
    
    geom_jitter(
      width = 0.12,
      size = 2.0,
      alpha = 0.55,
      color = "black"
    ) +
    
    annotate(
      "text",
      x = 1.5,
      y = y_pos,
      label = p_label,
      size = 4.3,
      fontface = "bold"
    ) +
    
    scale_fill_manual(
      values = c(
        "control" = "#F8766D",
        "treated" = "#00BFC4"
      )
    ) +
    
    labs(
      title = paste0(
        gene,
        " (",
        plot_label,
        ")"
      ),
      
      subtitle =
        "Wilcoxon rank-sum test across 2 groups",
      
      x = NULL,
      y = ylab
    ) +
    
    coord_cartesian(
      ylim = c(
        y_range[1],
        y_range[2] + y_pad
      )
    ) +
    
    theme_nature(
      base_size = 16
    ) +
    
    theme(
      plot.title = element_text(
        face = "bold",
        hjust = 0.5,
        size = 18
      ),
      
      plot.subtitle = element_text(
        hjust = 0.5,
        size = 12,
        face = "italic"
      ),
      
      axis.title = element_text(
        face = "bold",
        size = 18
      ),
      
      axis.text = element_text(
        size = 15
      ),
      
      legend.position = "none"
    )
  
  ggsave(
    file.path(
      expr_plot_dir,
      paste0(
        gene,
        "_group_boxplot_MTK26.png"
      )
    ),
    
    p,
    
    width = 6.4,
    height = 5.6,
    dpi = 300
  )
  
  wilcox_df <- if (
    !is.null(wilcox_res)
  ) {
    
    data.frame(
      gene = gene,
      test = "Wilcoxon rank-sum",
      p.value = wilcox_res$p.value,
      stringsAsFactors = FALSE
    )
    
  } else {
    
    data.frame(
      gene = gene,
      test = "Wilcoxon rank-sum",
      p.value = NA_real_,
      stringsAsFactors = FALSE
    )
  }
  
  wilcox_df
}

