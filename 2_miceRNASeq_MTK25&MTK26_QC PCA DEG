# ====================================================================
# ENRICHMENT PREPARATION
# ====================================================================
#
# IMPORTANT:
#
# ENTREZID is taken from row_map AFTER the DEG table has been
# constructed. This avoids the previous:
#
#   object 'ENTREZID' not found
#
# error.
#
# The ranked statistic is:
#
#   sign(log2FC) * -log10(pvalue)
#
# This is preferable to ranking only by log2FC because it
# incorporates both effect direction and statistical strength.
#
# ====================================================================

res_ranked <- res_df %>%
  
  filter(
    !is.na(ENTREZID),
    ENTREZID != "",
    !is.na(log2FoldChange),
    !is.na(pvalue),
    is.finite(log2FoldChange),
    is.finite(pvalue)
  ) %>%
  
  mutate(
    
    ENTREZID =
      as.character(
        ENTREZID
      ),
    
    pvalue_safe =
      pmax(
        pvalue,
        .Machine$double.xmin
      ),
    
    rank_metric =
      sign(
        log2FoldChange
      ) *
      -log10(
        pvalue_safe
      )
  ) %>%
  
