      subtitle = subtitle,
      x = xlab,
      y = ylab) +
    theme(
      panel.grid.major = element_line(linewidth = 0.3),
      panel.grid.minor = element_line(linewidth = 0.3))
  ggsave(file.path(out_dir, file), p, width = 6.5, height = 5.5)
  return(data.frame(
    comparison = title,
    rho = unname(ct$estimate),
    p_value = ct$p.value,
    significance = star,
    n = nrow(d)))}

