# PATHOLOGICAL STAGE ANALYSIS in TCGA-PRAD: Is FOLH1 (PSMA) expression associated with pathological tumor extent (T stage) in prostate cancer?

## setup
base_dir <- "C:/Users/Martina/Desktop/TCGA"
setwd(base_dir)
out_dir <- file.path(base_dir, "results")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

## packages
library(SummarizedExperiment)
library(AnnotationDbi)
library(org.Hs.eg.db)
library(dplyr)
library(ggplot2)
library(rstatix)
library(openxlsx)
library(ggpubr)
library(showtext)
font_add("Arial", "C:/Windows/Fonts/arial.ttf")
showtext_auto()

## load TCGA-PRAD 
prad <- readRDS("TCGA_PRAD_clinical.rds")

## extract FOLH1 
rd <- as.data.frame(rowData(prad))
ens <- gsub("\\..*", "", rd$gene_id)
symbols <- mapIds(
  org.Hs.eg.db,
  keys = ens,
  column = "SYMBOL",
  keytype = "ENSEMBL",
  multiVals = "first")
rd$symbol <- symbols
folh1_idx <- which(rd$symbol == "FOLH1")
if(length(folh1_idx) == 0){
  stop("FOLH1 not found.")}
folh1 <- as.numeric(
  assay(prad)[folh1_idx[1], ])

## build dataframe & clean
cd <- as.data.frame(colData(prad))
df <- data.frame(
  sample = colnames(prad),
  FOLH1 = folh1,
  stage = cd$ajcc_pathologic_t,
  sample_type = cd$sample_type)
df_stage <- df %>%
  filter(sample_type == "Primary Tumor")
df <- df %>%
  mutate(
    stage_group = case_when(
      !is.na(stage) & grepl("^T2", stage) ~ "T2",
      !is.na(stage) & grepl("^T3", stage) ~ "T3",
      !is.na(stage) & grepl("^T4", stage) ~ "T4",
      TRUE ~ NA_character_))
df <- df %>% filter(!is.na(stage_group))
df$stage_group <- factor(df$stage_group, levels = c("T2", "T3", "T4"))

## log transform FOLH1
df$logFOLH1 <- log2(df$FOLH1 + 1)

## primary statistics
kruskal_res <- kruskal_test(df, logFOLH1 ~ stage_group)
eta2 <- kruskal_effsize(df, logFOLH1 ~ stage_group)
kw_p <- kruskal_res$p
kw_sig <- ifelse(
  kw_p < 0.0001, "****",
  ifelse(
    kw_p < 0.001, "***",
    ifelse(
      kw_p < 0.01, "**",
      ifelse(
        kw_p < 0.05, "*",
        "ns"))))
summary_stats <- df %>%
  group_by(stage_group) %>%
  summarise(
    n = n(),
    mean_logFOLH1 = mean(logFOLH1),
    median_logFOLH1 = median(logFOLH1),
    sd_logFOLH1 = sd(logFOLH1),
    min_logFOLH1 = min(logFOLH1),
    max_logFOLH1 = max(logFOLH1),
    .groups = "drop")

## pairwise comparison (Dunn test, BH correction)
pairwise <- dunn_test(
  df,
  logFOLH1 ~ stage_group,
  p.adjust.method = "BH") %>%
  mutate(
    significance = case_when(
      p.adj < 0.0001 ~ "",
      p.adj < 0.001 ~ "*",
      p.adj < 0.01 ~ "",
      p.adj < 0.05 ~ "*",
      TRUE ~ "ns"))

## secondary statistics: ANOVA
anova_model <- aov(logFOLH1 ~ stage_group, data = df)
anova_table <- as.data.frame(summary(anova_model)[[1]])
anova_table$term <- rownames(anova_table)
rownames(anova_table) <- NULL
tukey <- TukeyHSD(anova_model)$stage_group
tukey_df <- as.data.frame(tukey)
tukey_df$comparison <- rownames(tukey_df)
rownames(tukey_df) <- NULL

## summary
wb <- createWorkbook()
addWorksheet(wb, "Summary_stats")
writeData(wb, "Summary_stats", summary_stats)
addWorksheet(wb, "Kruskal_Wallis")
writeData(wb, "Kruskal_Wallis", kruskal_res)
addWorksheet(wb, "Effect_size_eta2")
writeData(wb, "Effect_size_eta2", eta2)
addWorksheet(wb, "Pairwise_Dunn")
writeData(wb, "Pairwise_Dunn", pairwise)
addWorksheet(wb, "ANOVA_optional")
writeData(wb, "ANOVA_optional", anova_table)
addWorksheet(wb, "Tukey_optional")
writeData(wb, "Tukey_optional", tukey_df)
saveWorkbook(wb,
  file.path(out_dir, "7_TCGA-PRAD_FOLH1_Tstage_analysis.xlsx"),
  overwrite = TRUE)

## plot
p <- ggplot(df, aes(x = stage_group, y = logFOLH1, fill = stage_group)) +
  geom_boxplot(width = 0.6, outlier.shape = NA, alpha = 0.8) +
  geom_jitter(width = 0.15, size = 1.2, alpha = 0.4) +
  scale_fill_manual(values = c("T2" = "grey70", "T3" = "orange", "T4" = "red3")) +
  theme_bw(base_size = 16) +
  theme(
    legend.position = "none",
    text = element_text(family = "Arial"),
    panel.grid.major = element_line(linewidth = 0.3),
    panel.grid.minor = element_line(linewidth = 0.3)) +
  labs(
    title = "FOLH1 expression across pathological T stage",
    subtitle = paste0(
      "Kruskal-Wallis test: ",
      kw_sig,
      " (p = ",
      signif(kw_p, 3),
      ") | eta² = ",
      round(eta2$effsize, 3)),
    x = "Pathological T stage",
    y = "log2(FOLH1 + 1)")
print(p)
ggsave( file.path(out_dir, "7_TCGA-PRAD_FOLH1_Tstage_plot.pdf"), p, width = 6.5, height = 5.5 )
