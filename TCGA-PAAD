  pink1_row,
]

############################################################
# Clinical data
############################################################

clinical <- as.data.frame(
  colData(data)
)

############################################################
# Match samples
############################################################

common_samples <- intersect(
  names(pink1_expr),
  rownames(clinical)
)

clinical <- clinical[
  common_samples,
]

pink1_expr <- pink1_expr[
  common_samples
]

############################################################
# Survival dataframe
############################################################

surv_df <- data.frame(
  Sample = common_samples,
  PINK1 = as.numeric(pink1_expr),
  days_to_death =
    clinical$days_to_death,
  days_to_last_follow_up =
    clinical$days_to_last_follow_up,
  vital_status =
    clinical$vital_status
)

############################################################
# Overall survival
############################################################

surv_df$OS_time <- ifelse(
  !is.na(surv_df$days_to_death),
  surv_df$days_to_death,
  surv_df$days_to_last_follow_up
)

surv_df$OS_event <- ifelse(
  surv_df$vital_status == "Dead",
  1,
  0
)

surv_df <- surv_df[
  !is.na(surv_df$OS_time),
]

############################################################
# Optimal cutoff
############################################################

cut <- maxstat.test(
  Surv(OS_time, OS_event) ~ PINK1,
  data = surv_df,
  smethod = "LogRank",
  pmethod = "HL"
)

optimal_cutoff <- cut$estimate

