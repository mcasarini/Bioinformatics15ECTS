make_heatmap <- function(n_genes, filename){
  
  # top genes by significance
  top_genes <- rownames(head(sig_genes, n_genes))
  
  # expression matrix
  mat <- SummarizedExperiment::assay(vsd)[top_genes, ]
  
  # z-score normalization
  mat <- t(scale(t(mat)))
  
  # replace ENSG IDs with gene symbols
  gene_symbols <- sig_genes[
    match(top_genes, rownames(sig_genes)),
    "gene_name"
  ]
  
  rownames(mat) <- gene_symbols
  
  # sample annotation
  annotation <- data.frame(
    Group = sample_info$group
  )
  
  rownames(annotation) <- colnames(mat)
  
  ann_colors <- list(
    Group = c(
      Normal = "#4DBBD5",
      Tumor = "#E64B35"
    )
  )
  
  pheatmap(
    mat,
    annotation_col = annotation,
    annotation_colors = ann_colors,
    
    cluster_rows = TRUE,
    cluster_cols = TRUE,
    
    show_colnames = FALSE,
    border_color = NA,
    
    fontsize_row = 10,
    
    color = colorRampPalette(
      c(
        "#2166AC",
        "white",
        "#B2182B"
      )
    )(100),
    
    main = paste(
      "TCGA-PAAD Top",
      n_genes,
      "Differentially Expressed Genes"
    ),
    
    filename = filename,
    width = 10,
    height = 10
  )
}
