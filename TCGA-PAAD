# Query TCGA Pancreatic Adenocarcinoma RNA-seq data
query <- GDCquery(
  project = "TCGA-PAAD",
  data.category = "Transcriptome Profiling",
  data.type = "Gene Expression Quantification",
  workflow.type = "STAR - Counts"
)

# Download data
GDCdownload(query)

# Prepare data into a SummarizedExperiment object
data <- GDCprepare(query)

# Inspect data
data

# Expression matrix dimensions
dim(assay(data))

# Sample metadata
colData(data)

# Gene annotations
rowData(data)

# Save for later use
saveRDS(data, file = "TCGA_PAAD_STAR_Counts.rds")
write.csv(
  as.data.frame(assay(data)),
  "TCGA_PAAD_counts.csv")

# check
table(colData(data)$sample_type)

# DESeq2
sample_info <- as.data.frame(colData(data))
sample_info$group <- ifelse(
  sample_info$sample_type == "Primary Tumor",
  "Tumor",
  ifelse(
    sample_info$sample_type == "Solid Tissue Normal",
    "Normal",
    NA
  )
)

# significant genes
keep <- !is.na(sample_info$group)
counts <- assay(data)[, keep]
sample_info <- sample_info[keep, ]
table(sample_info$group)
library(DESeq2)
dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = sample_info,
  design = ~ group
)
dds <- dds[rowSums(counts(dds)) > 10, ]
dds$group <- factor(dds$group)
dds$group <- relevel(dds$group, ref = "Normal")
dds <- DESeq(dds)
res <- results(dds)

# create results table
res_df <- as.data.frame(res)
res_df$gene_name <- rowData(data)$gene_name[
  match(rownames(res_df), rownames(data))
]
res_df <- res_df[order(res_df$padj), ]
head(res_df[, c("gene_name", "log2FoldChange", "padj")], 20)

# convert list columns to text
clinical <- as.data.frame(colData(data))

clinical[] <- lapply(clinical, function(x) {
  if (is.list(x)) {
    sapply(x, function(y) paste(y, collapse = "; "))
  } else {
    x
  }
})

# Save DESeq2 results
write.csv(
  res_df,
  "TCGA_PAAD_DESeq2_results.csv",
  row.names = TRUE)

# Save significant genes only
sig_genes <- subset(
  res_df,
  padj < 0.05 & abs(log2FoldChange) > 1)
