save_dotplot <- function(
    enrich_obj,
    filename,
    title,
    width = 3200,
    height = 2400,
    showCategory = 15
){
  
  if(
    is.null(enrich_obj) ||
    nrow(as.data.frame(enrich_obj)) == 0
  ){
    return(NULL)
  }
  
  p <- dotplot(
    enrich_obj,
    showCategory = showCategory
  ) +
    
    scale_y_discrete(
      labels = function(x)
        stringr::str_wrap(
          x,
          width = 45
        )
    ) +
    
    ggtitle(title) +
    
    theme_bw(base_size = 14) +
    
    theme(
      
      axis.text.y = element_text(
        size = 11
      ),
      
      axis.text.x = element_text(
        size = 12
      ),
      
      plot.title = element_text(
        size = 16,
        face = "bold",
        hjust = 0.5
      )
      
    )
  
  png(
    filename,
    width = width,
    height = height,
    res = 300
  )
  
  print(p)
  
  dev.off()
  
}

