# High vs Low groups
############################################################

surv_df$PINK1_Group <- ifelse(
  surv_df$PINK1 > optimal_cutoff,
  "High",
  "Low"
)

surv_df$PINK1_Group <- factor(
  surv_df$PINK1_Group,
  levels = c(
    "Low",
    "High"
  )
)

