# ============================================================
# PINK1 EXPRESSION
# ============================================================

pink1_expr <- as.numeric(
  
  expr_log2["PINK1", ]
  
)
# ============================================================
# GENOME-WIDE CORRELATIONS
# ============================================================

all_genes <- rownames(expr_log2)

cor_results <- vector(
  
  "list",
  
  length(all_genes)
  
)

for(i in seq_along(all_genes)){
  
  gene <- all_genes[i]
  
  gene_expr <- as.numeric(
    
    expr_log2[gene, ]
    
  )
  
  ct <- suppressWarnings(
    
    cor.test(
      
      pink1_expr,
      
      gene_expr,
      
      method = "spearman"
      
    )
    
  )
  
  cor_results[[i]] <- data.frame(
    
    Gene = gene,
    
    Rho = unname(
      ct$estimate
    ),
    
    Pvalue = ct$p.value
    
  )
  
}
# ============================================================
# CORRELATION TABLE
# ============================================================

cor_table <- do.call(
  
  rbind,
  
  cor_results
  
)

cor_table <- cor_table %>%
  
  mutate(
    
    FDR = p.adjust(
      
      Pvalue,
      
      method = "BH"
      
    )
    
  ) %>%
  
  arrange(
    
    desc(Rho)
    
  )

write.csv(
  
  cor_table,
  
  file.path(
    
    network_dir,
    
    "PINK1_Genomewide_Correlations.csv"
    
  ),
  
  row.names = FALSE
  
)

