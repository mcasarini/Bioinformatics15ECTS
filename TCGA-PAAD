############################################################
# Top 50/15/10 PINK1-correlated genes heatmap
############################################################

make_corr_heatmap <- function(
    n_genes,
    filename){
  
  genes <- unique(
    c(
      "PINK1",
      head(
        positive$Gene,
        n_genes - 1
      )
    )
  )
  
  rows <- which(
    rowData(data)$gene_name %in% genes
  )
  
  mat <- expr[rows, ]
  
  mat <- t(
    scale(
      t(mat)
    )
  )
  
  rownames(mat) <- make.unique(
    rowData(data)$gene_name[rows]
  )
  
  annotation <- data.frame(
    Group = colData(vsd)$group
  )
  
  rownames(annotation) <- colnames(vsd)
  
  ann_colors <- list(
    Group = c(
      Tumor = "#E64B35",
      Normal = "#4DBBD5"
    )
  )
  
  pheatmap(
    mat,
    
    annotation_col = annotation,
    annotation_colors = ann_colors,
    
    cluster_rows = TRUE,
    cluster_cols = TRUE,
    
    show_colnames = FALSE,
    
    border_color = NA,
    
    fontsize_row = 10,
    
    color = colorRampPalette(
      c(
        "#2166AC",
        "white",
        "#B2182B"
      )
    )(100),
    
    main = paste(
      "Top",
      n_genes,
      "PINK1-Correlated Genes"
    ),
    
    filename = filename,
    
    width = 10,
    height = 10
  )
}
