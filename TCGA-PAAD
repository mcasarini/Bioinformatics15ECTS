library(dplyr)

############################################################
# Directory
############################################################

dir.create(
  "C:/Users/Martina/Desktop/New folder/results/TCGA-PAAD_analysis/09_PINK1_Correlation",
  recursive = TRUE,
  showWarnings = FALSE
)

setwd(
  "C:/Users/Martina/Desktop/New folder/results/TCGA-PAAD_analysis/09_PINK1_Correlation"
)

############################################################
# Load data
############################################################

data <- readRDS(
  "../rawdata/TCGA_PAAD_STAR_Counts.rds"
)

dds <- readRDS(
  "../rawdata/dds.rds"
)

############################################################
# Normalized expression
############################################################

vsd <- varianceStabilizingTransformation(
  dds,
  blind = FALSE
)

expr <- SummarizedExperiment::assay(vsd)

############################################################
# Locate PINK1
############################################################

pink1_row <- which(
  rowData(data)$gene_name == "PINK1"
)

if(length(pink1_row) == 0){
  stop("PINK1 not found.")
}

############################################################
# PINK1 expression vector
############################################################

pink1_expr <- as.numeric(
  expr[pink1_row, ]
)

############################################################
# Correlate with every gene
############################################################

results <- lapply(
  1:nrow(expr),
  function(i){
    
    test <- suppressWarnings(
      cor.test(
        pink1_expr,
        as.numeric(expr[i, ]),
        method = "spearman"
      )
    )
    
    c(
      rho = test$estimate,
      pvalue = test$p.value
    )
  }
)

results <- do.call(
  rbind,
  results
)

gene_info <- data.frame(
  Ensembl = rownames(data),
  Gene = rowData(data)$gene_name
)

gene_info <- gene_info[
  match(
    rownames(expr),
    gene_info$Ensembl
  ),
]

corr_df <- data.frame(
  Ensembl = rownames(expr),
  Gene = gene_info$Gene,
  rho = results[,1],
  pvalue = results[,2]
)
length(gene_info$Gene)
nrow(expr)
dim(results)

############################################################
# Multiple testing correction
############################################################

corr_df$padj <- p.adjust(
  corr_df$pvalue,
  method = "BH"
)

corr_df <- corr_df[
  order(
    -abs(corr_df$rho)
  ),
]

############################################################
# Save complete results
############################################################

write.csv(
  corr_df,
  "PINK1_All_Correlations.csv",
  row.names = FALSE
)

############################################################
# Significant genes
############################################################

sig_corr <- subset(
  corr_df,
  padj < 0.05 &
    abs(rho) > 0.3
)

write.csv(
  sig_corr,
  "PINK1_Significant_Correlations.csv",
  row.names = FALSE
)

############################################################
# Positive correlations
############################################################

positive <- sig_corr %>%
  filter(rho > 0) %>%
  arrange(desc(rho))

write.csv(
  head(positive, 100),
  "PINK1_Top_Positive_Correlations.csv",
  row.names = FALSE
)

############################################################
# Negative correlations
############################################################

negative <- sig_corr %>%
  filter(rho < 0) %>%
  arrange(rho)

write.csv(
  head(negative, 100),
  "PINK1_Top_Negative_Correlations.csv",
  row.names = FALSE
)

############################################################
