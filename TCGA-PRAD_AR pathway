# Relationship between FOLH1 expression and the Androgen Receptor Pathway in TCGA-PRAD
Is FOLH1 expression associated with androgen receptor signaling? Does FOLH1 increase together with TMPRSS2 expression? Does ERG fusion define tumors with different FOLH1 expression?

## setup
base_dir <- "C:/Users/Martina/Desktop/TCGA"
setwd(base_dir)
out_dir <- file.path(base_dir, "results")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

## packages
library(SummarizedExperiment)
library(dplyr)
library(ggplot2)
library(openxlsx)
library(ggpubr)
library(AnnotationDbi)
library(org.Hs.eg.db)

## load & check data
prad <- readRDS("TCGA_PRAD_clinical.rds")
class(prad)
assayNames(prad)
dim(assay(prad))
prad_class <- paste(class(prad), collapse = "; ")
assays_available <- paste(assayNames(prad), collapse = "; ")
assay_dim <- paste(dim(assay(prad)), collapse = " x ")
mat <- assay(prad, "tpm_unstrand")
cd <- as.data.frame(colData(prad))
keep_samples <- rownames(cd)[cd$sample_type == "Primary Tumor"]
cd <- cd[keep_samples, , drop = FALSE]
mat <- mat[, keep_samples, drop = FALSE]

## gene annotation (ENSEMBL → SYMBOL)
gene_ids <- gsub("\\..*", "", rownames(mat))
symbols <- mapIds(
  org.Hs.eg.db,
  keys = gene_ids,
  column = "SYMBOL",
  keytype = "ENSEMBL",
  multiVals = "first")
rownames(mat) <- gene_ids

## extract genes
genes <- c(
  "FOLH1",,
  "KLK3",
  "FKBP5",
  "NKX3-1",
  "TMPRSS2",
  "ERG")
gene_index <- match(genes, symbols)
if(any(is.na(gene_index))){
  stop(paste(
      "missing genes:",
      paste(genes[is.na(gene_index)], collapse = ", ")))}
expr <- t(mat[gene_index, , drop = FALSE])
colnames(expr) <- genes
expr <- as.data.frame(log2(expr + 1))

## build dataframe
df <- data.frame(
  sample = keep_samples,
  PSA = suppressWarnings(as.numeric(cd$paper_PSA_preop)),
  AR_score = suppressWarnings(as.numeric(cd$paper_AR_score)),
  ERG_status = factor(cd$paper_ERG_status),
  sample_type = cd$sample_type,
  stringsAsFactors = FALSE)
df <- df %>% filter(sample_type == "Primary Tumor")
stopifnot(nrow(df) == nrow(expr))
stopifnot(all(df$sample == rownames(expr)))
df$ERG_status <- factor(df$ERG_status,levels = c("none", "fusion"))
df <- cbind(df, expr)
str(df)
head(df)

## significance
sig_star <- function(p) {
  if (p < 0.001) return("***")
  else if (p < 0.01) return("**")
  else if (p < 0.05) return("*")
  else return("ns")}

## correlation analysis & plot
plot_correlation <- function(data,
                             xvar,
                             yvar,
                             xlab,
                             ylab,
                             title,
                             filename){
  df_plot <- data %>%
    filter(!is.na(.data[[xvar]]),
           !is.na(.data[[yvar]]))
  cor_res <- cor.test(
    df_plot[[xvar]],
    df_plot[[yvar]],
    method = "spearman")
  star <- sig_star(cor_res$p.value)
  
  p <- ggplot(df_plot,
              aes(x = .data[[xvar]],
                  y = .data[[yvar]])) +
    geom_point(alpha = 0.6, size = 2) +
    geom_smooth(
      method = "loess",
      se = TRUE,
      linewidth = 0.8)+
    theme_bw(base_size = 14) +
    theme(
      panel.grid.major = element_line(linewidth = 0.3),
      panel.grid.minor = element_line(linewidth = 0.3)) +
    labs(
      title = title,
      subtitle = paste0(
        "Spearman's rho = ",
        round(cor_res$estimate, 3),
        " | p = ",
        signif(cor_res$p.value, 3),
        " (", star, ")",
        " | n = ",
        nrow(df_plot)),
      x = xlab,
      y = ylab)
  
  ggsave(
    file.path(out_dir, filename),
    p,
    width = 6.5,
    height = 5.5)
  data.frame(
    comparison = title,
    rho = unname(cor_res$estimate),
    p_value = cor_res$p.value,
    significance = star,
    n = nrow(df_plot))}

## FOLH1 vs KLK3 correlation
stats_KLK3 <- plot_correlation(
  df,
  "FOLH1",
  "KLK3",
  "log2(FOLH1 TPM + 1)",
  "log2(KLK3 TPM + 1)",
  "FOLH1 vs KLK3 expression",
  "8b_TCGA-PRAD_FOLH1vsKLK3.pdf")

## FOLH1 vs FKBP5 correlation
stats_FKBP5 <- plot_correlation(
  df,
  "FOLH1",
  "FKBP5",
  "log2(FOLH1 TPM + 1)",
  "log2(FKBP5 TPM + 1)",
  "FOLH1 vs FKBP5 expression",
  "8b_TCGA-PRAD_FOLH1vsFKBP5.pdf")

## FOLH1 vs NKX3-1
stats_NKX31 <- plot_correlation(
  df,
  "FOLH1",
  "NKX3-1",
  "log2(FOLH1 TPM + 1)",
  "log2(NKX3-1 TPM + 1)",
  "FOLH1 vs NKX3-1 expression",
  "8b_TCGA-PRAD_FOLH1vsNKX3-1.pdf")

## FOLH1 vs TMPRSS2 correlation
stats_TMPRSS2 <- plot_correlation(
  df,
  "FOLH1",
  "TMPRSS2",
  "log2(FOLH1 TPM + 1)",
  "log2(TMPRSS2 TPM + 1)",
  "FOLH1 vs TMPRSS2 expression",
  "8b_TCGA-PRAD_FOLH1vsTMPRSS2.pdf")

## FOLH1 vs ERG expression
stats_ERGexpr <- plot_correlation(
  df,
  "FOLH1",
  "ERG",
  "log2(FOLH1 TPM + 1)",
  "log2(ERG TPM + 1)",
  "FOLH1 vs ERG expression",
  "8b_TCGA-PRAD_FOLH1vsERGexpression.pdf")

## statistics (Benjamini-Hochberg correction)
stats_all <- bind_rows(
  stats_KLK3,
  stats_FKBP5,
  stats_NKX31,
  stats_TMPRSS2,
  stats_ERGexpr)
stats_all$p_adj_BH <- p.adjust(
  stats_all$p_value,
  method = "BH")
stats_all$BH_significance <- sapply(
  stats_all$p_adj_BH,
  sig_star)

