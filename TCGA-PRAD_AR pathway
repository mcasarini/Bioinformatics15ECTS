writeData(wb, "QC", qc)
addWorksheet(wb, "Summary")
writeData(wb, "Summary", stats_all)
addWorksheet(wb, "FOLH1_vs_KLK3")
writeData(wb, "FOLH1_vs_KLK3", stats_KLK3)
addWorksheet(wb, "FOLH1_vs_FKBP5")
writeData(wb, "FOLH1_vs_FKBP5", stats_FKBP5)
addWorksheet(wb, "FOLH1_vs_NKX3-1")
writeData(wb, "FOLH1_vs_NKX3-1", stats_NKX31)
addWorksheet(wb, "FOLH1_vs_TMPRSS2")
writeData(wb, "FOLH1_vs_TMPRSS2", stats_TMPRSS2)
addWorksheet(wb, "FOLH1_vs_ERG_expr")
writeData(wb, "FOLH1_vs_ERG_expr", stats_ERGexpr)
saveWorkbook(wb,
  file.path(out_dir,
