# immune cell biomarkers analysis in TCGA-PRAD
Is FOLH1 expression associated with immune microenvironment markers in primary TCGA-PRAD?

## setup
base_dir <- "C:/Users/Martina/Desktop/TCGA"
setwd(base_dir)
out_dir <- file.path(base_dir, "results")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

## packages
library(SummarizedExperiment)
library(dplyr)
library(ggplot2)
library(openxlsx)
library(AnnotationDbi)
library(org.Hs.eg.db)
library(pheatmap)
font_add("Arial", "C:/Windows/Fonts/arial.ttf")
showtext_auto()

## TCGA-PRAD 
prad <- readRDS("TCGA_PRAD_clinical.rds")
se <- prad
expr <- assay(se)
cd <- as.data.frame(colData(se))
rd <- as.data.frame(rowData(se))

## gene annotation
ens <- gsub("\\..*", "", rd$gene_id)
symbols <- mapIds(
  org.Hs.eg.db,
  keys = ens,
  column = "SYMBOL",
  keytype = "ENSEMBL",
  multiVals = "first")
rd$symbol <- symbols
rowData(se)$symbol <- symbols

## extract FOLH1 expression
folh1_idx <- which(rd$symbol == "FOLH1")
stopifnot(length(folh1_idx) > 0)
folh1 <- as.numeric(expr[folh1_idx[1], ])

## immune gene panels
immune_genes <- c(
  "CD8A","CD8B",
  "CD3D","CD3E",
  "GZMB","PRF1",
  "FOXP3","IL2RA",
  "PDCD1","CTLA4","LAG3","TIGIT",
  "CD68","CD163","MRC1",
  "ITGAX","HLA-DRA",
  "NCR1","KLRD1",
  "MS4A1","CD19")

## gene vector
immune_mat <- sapply(immune_genes, function(gene) {
  idx <- which(rd$symbol == gene)
  if (length(idx) == 0) {
    return(rep(NA_real_, ncol(expr)))}
  as.numeric(expr[idx[1], ])})
immune_mat <- apply(immune_mat, 2, as.numeric)
colnames(immune_mat) <- immune_genes

## dataframe
df <- data.frame(
  sample = colnames(se),
  FOLH1 = as.numeric(folh1),
  immune_mat,
  sample_type = cd$sample_type,
  project = cd$project_id,
  check.names = FALSE)
df <- df %>%
  filter(sample_type == "Primary Tumor") %>%
  na.omit()
df$logFOLH1 <- log2(df$FOLH1 + 1)

## high vs low FOLH1 groups
df$FOLH1_group <- ifelse(
  df$FOLH1 >= median(df$FOLH1, na.rm = TRUE),
  "High",
  "Low")
df$FOLH1_group <- factor(df$FOLH1_group, levels = c("Low", "High"))

## correlation analysis (Spearman)
cor_results <- data.frame()
for (g in immune_genes) {
  x <- as.numeric(df$FOLH1)
  y <- as.numeric(df[[g]])
  ok <- complete.cases(x, y)
  if (sum(ok) < 10) next
  test <- cor.test(x[ok], y[ok], method = "spearman")
  cor_results <- rbind(cor_results, data.frame(
    gene = g,
    rho = as.numeric(test$estimate),
    p_value = test$p.value))}
cor_results$adj_p <- p.adjust(cor_results$p_value, method = "BH")
cor_results <- cor_results[order(abs(cor_results$rho), decreasing = TRUE), ]
print(head(cor_results, 10))

## high vs low immune comparison
group_results <- data.frame()
for (g in immune_genes) {
  test <- wilcox.test(df[[g]] ~ df$FOLH1_group)
  group_results <- rbind(group_results, data.frame(
    gene = g,
    p_value = test$p.value,
    significance = ifelse(
      test$p.value < 0.0001, "****",
      ifelse(test$p.value < 0.001, "***",
             ifelse(test$p.value < 0.01, "**",
                    ifelse(test$p.value < 0.05, "*", "ns"))))))}

## heatmap
heatmap_mat <- as.matrix(df[, immune_genes])
rownames(heatmap_mat) <- df$sample
heatmap_mat <- scale(heatmap_mat)
annotation <- data.frame(FOLH1_group = df$FOLH1_group)
rownames(annotation) <- df$sample
pdf(file.path(out_dir, "FOLH1_ImmuneAnalysis_Heatmap.pdf"), width = 8, height = 6)
pheatmap(
  t(heatmap_mat),
  annotation_col = annotation,
  show_colnames = FALSE,
  main = "FOLH1 vs Immune Microenvironment (PRAD)")
dev.off()
print(head(cor_results, 10))

## summary
wb <- createWorkbook()
addWorksheet(wb, "Correlation")
writeData(wb, "Correlation", cor_results)
addWorksheet(wb, "Group_Comparison")
writeData(wb, "Group_Comparison", group_results)
addWorksheet(wb, "Summary")
writeData(wb, "Summary", data.frame(
  n_samples = nrow(df),
  n_genes = length(immune_genes),
  median_FOLH1 = median(df$FOLH1)))
saveWorkbook(
  wb,
  file.path(out_dir, "FOLH1_ImmuneAnalysis_PRAD.xlsx"),
  overwrite = TRUE)
