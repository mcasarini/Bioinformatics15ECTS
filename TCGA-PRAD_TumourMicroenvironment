# FOLH1 IMMUNE PHENOTYPE (TUMOUR MICROENVIRONMENT) ANALYSIS in TCGA-PRAD
Do PSMA-high (FOLH1-high) prostate tumours differ in immune phenotype from PSMA-low tumours?

## set
base_dir <- "C:/Users/Martina/Desktop/TCGA"
setwd(base_dir)
out_dir <- file.path(base_dir, "results")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

## packages
library(SummarizedExperiment)
library(DESeq2)
library(dplyr)
library(ggplot2)
library(tidyr)
library(openxlsx)
library(pheatmap)
library(AnnotationDbi)
library(org.Hs.eg.db)
library(showtext)
font_add("Arial", "C:/Windows/Fonts/arial.ttf")
showtext_auto()

## theme
theme_set(
  theme_bw(base_size = 16) +
    theme(
      text = element_text(family = "Arial"),
      panel.grid.major = element_line(linewidth = 0.3),
      panel.grid.minor = element_blank()
    )
)

## load data
prad <- readRDS("TCGA_PRAD_clinical.rds")
cd <- as.data.frame(colData(prad))
rd <- as.data.frame(rowData(prad))

## normalization
dds <- DESeqDataSetFromMatrix(
  countData = assay(prad),
  colData = colData(prad),
  design = ~ 1
)
dds <- estimateSizeFactors(dds)
vsd <- varianceStabilizingTransformation(
  dds,
  blind = TRUE
)
expr_norm <- assay(vsd)

## gene annotation
ens <- gsub("\\..*", "", rd$gene_id)
symbols <- mapIds(
  org.Hs.eg.db,
  keys = ens,
  column = "SYMBOL",
  keytype = "ENSEMBL",
  multiVals = "first"
)
rd$symbol <- symbols

## primary tumours only
print(table(cd$sample_type))
primary_idx <- which(cd$sample_type == "Primary Tumor")
if(length(primary_idx) == 0){
  stop("No Primary Tumor samples found.")
}
expr_norm_tumor <- expr_norm[, primary_idx]
cd_tumor <- cd[primary_idx, ]

## FOLH1 expression
folh1_idx <- which(rd$symbol == "FOLH1")
if(length(folh1_idx) == 0){
  stop("FOLH1 not found.")
}
folh1 <- as.numeric(
  expr_norm_tumor[folh1_idx[1], ]
)

# dataframe
df <- data.frame(
  sample = colnames(expr_norm_tumor),
  FOLH1 = folh1,
  sample_type = cd_tumor$sample_type,
  stringsAsFactors = FALSE)

# immune signatures
signature_list <- list(
  Cytotoxic_T = c(
    "CD8A","CD8B","GZMB","PRF1"
  ),
  Treg = c(
    "FOXP3","IL2RA"
  ),
  Exhausted_T = c(
    "PDCD1","CTLA4","LAG3","TIGIT"
  ),
  M2_Macrophage = c(
    "CD68","CD163","MRC1"
  ),
  APC_DC = c(
    "ITGAX","HLA-DRA"
  )
)

# signature scores
for(sig in names(signature_list)) {
  genes <- signature_list[[sig]]
  present <- unique(
    genes[genes %in% rd$symbol]
  )
  if(length(present) == 0){
    df[[sig]] <- NA
  } else {
    gene_scores <- sapply(
      present,
      function(g){
        idx <- which(rd$symbol == g)
        if(length(idx) == 1){
          expr_norm_tumor[idx, ]
        } else {
          colMeans(
            expr_norm_tumor[idx, , drop = FALSE],
            na.rm = TRUE
          )
        }
      }
    )
    gene_scores <- t(as.matrix(gene_scores))
    df[[sig]] <- colMeans(
      gene_scores,
      na.rm = TRUE
    )
  }
}

# median split
median_folh1 <- median(
  df$FOLH1,
  na.rm = TRUE
)
df$FOLH1_group <- ifelse(
  df$FOLH1 >= median_folh1,
  "High",
  "Low"
)
df$FOLH1_group <- factor(
  df$FOLH1_group,
  levels = c("Low","High")
)

# group comparison
immune_stats <- data.frame()
for(sig in names(signature_list)) {
  if(all(is.na(df[[sig]]))) next
  w <- wilcox.test(
    df[[sig]] ~ df$FOLH1_group
  )
  low_med <- median(
    df[df$FOLH1_group == "Low", sig],
    na.rm = TRUE
  )
  high_med <- median(
    df[df$FOLH1_group == "High", sig],
    na.rm = TRUE
  )
  immune_stats <- rbind(
    immune_stats,
    data.frame(
      Signature = sig,
      Low_Median = low_med,
      High_Median = high_med,
      Difference = high_med - low_med,
      Percent_Difference =
        ifelse(
          abs(low_med) > 1e-6,
          ((high_med - low_med) /
             abs(low_med)) * 100,
          NA
        ),
      p_value = w$p.value
    )
  )
}
immune_stats$FDR <- p.adjust(
  immune_stats$p_value,
  method = "BH"
)
immune_stats$Significance <- ifelse(
  immune_stats$FDR < 1e-4, "****",
  ifelse(
    immune_stats$FDR < 1e-3, "***",
    ifelse(
      immune_stats$FDR < 1e-2, "**",
      ifelse(
        immune_stats$FDR < 0.05,
        "*",
        "ns"
      )
    )
  )
)
immune_stats <- immune_stats %>%
  arrange(FDR)
print(immune_stats)

## correlations
cor_results <- data.frame()
for(sig in names(signature_list)) {
  if(all(is.na(df[[sig]]))) next
  ct <- cor.test(
    df$FOLH1,
    df[[sig]],
    method = "spearman",
    exact = FALSE
  )
  cor_results <- rbind(
    cor_results,
    data.frame(
      Signature = sig,
      rho = as.numeric(ct$estimate),
      p_value = ct$p.value
    )
  )
}
cor_results$FDR <- p.adjust(
  cor_results$p_value,
  method = "BH"
)
cor_results$Significance <- ifelse(
  cor_results$FDR < 1e-4, "****",
  ifelse(
    cor_results$FDR < 1e-3, "***",
    ifelse(
      cor_results$FDR < 1e-2, "**",
      ifelse(
        cor_results$FDR < 0.05,
        "*",
        "ns"
      )
    )
  )
)
cor_results$Direction <- ifelse(
  cor_results$rho > 0,
  "Positive",
  "Negative"
)
cor_results$Heatmap_Label <- paste0(
  sprintf("%.2f", cor_results$rho),
  " ",
  cor_results$Significance
)

# heatmap
heat <- matrix(
  cor_results$rho,
  nrow = 1,
  dimnames = list(
    "FOLH1",
    cor_results$Signature
  )
)
display_mat <- matrix(
  paste0(
    sprintf("%.2f", cor_results$rho),
    "\n",
    cor_results$Significance
  ),
  nrow = 1,
  dimnames = list(
    "FOLH1",
    cor_results$Signature
  )
)
showtext_auto(FALSE)
pdf(
  file.path(
    out_dir,
    "FOLH1_Immune_Heatmap.pdf"
  ),
  width = 9,
  height = 3
)
pheatmap(
  heat,
  cluster_rows = FALSE,
  cluster_cols = FALSE,
  display_numbers = display_mat,
  fontsize = 14,
  fontsize_number = 14,
  number_color = "black",
  border_color = "grey70",
  color = colorRampPalette(
    c("navy","white","firebrick3")
  )(100),
  breaks = seq(-1,1,length.out = 101),
  angle_col = 0,
  main = "Correlation of FOLH1 with immune signatures"
)
dev.off()
showtext_auto(TRUE)

# boxplots
plot_df <- df %>%
  select(
    FOLH1_group,
    all_of(names(signature_list))
  ) %>%
  pivot_longer(
    cols = -FOLH1_group,
    names_to = "Signature",
    values_to = "Score"
  )
sig_labels <- immune_stats %>%
  select(
    Signature,
    Significance,
    FDR
  )
sig_labels$label <- paste0(
  sig_labels$Significance,
  "\nFDR=",
  formatC(
    sig_labels$FDR,
    format = "e",
    digits = 2
  )
)
ypos <- plot_df %>%
  group_by(Signature) %>%
  summarise(
    y = max(Score, na.rm = TRUE) * 1.18,
    .groups = "drop"
  )
sig_labels <- left_join(
  sig_labels,
  ypos,
  by = "Signature"
)
sig_labels$x <- 1.5
p <- ggplot(
  plot_df,
  aes(
    FOLH1_group,
    Score,
    fill = FOLH1_group
  )
) +
  geom_boxplot(
    width = 0.6,
    outlier.shape = NA
  ) +
  geom_jitter(
    width = 0.12,
    alpha = 0.35,
    size = 0.7
  ) +
  geom_text(
    data = sig_labels,
    aes(
      x = x,
      y = y,
      label = label
    ),
    inherit.aes = FALSE,
    size = 6
  ) +
  facet_wrap(
    ~ Signature,
    scales = "free_y"
  ) +
  scale_fill_manual(
    values = c(
      Low = "grey70",
      High = "red3"
    )
  ) +
  theme_bw(base_size = 16) +
  theme(
    legend.position = "none",
    strip.background = element_blank()
  ) +
  labs(
    title = "Immune phenotype of PSMA-high prostate tumours",
    subtitle = "Wilcoxon test with BH correction",
    x = "",
    y = "Immune signature score"
  )
ggsave(
  file.path(
    out_dir,
    "FOLH1_ImmunePhenotype.pdf"
  ),
  p,
  width = 12,
  height = 7
)

## excel output
group_counts <- data.frame(
  Group = names(
    table(df$FOLH1_group)
  ),
  Count = as.numeric(
    table(df$FOLH1_group)
  )
)
wb <- createWorkbook()
addWorksheet(
  wb,
  "Immune_Signatures"
)
writeData(
  wb,
  "Immune_Signatures",
  immune_stats
)
addWorksheet(
  wb,
  "Correlations"
)
writeData(
  wb,
  "Correlations",
  cor_results
)
addWorksheet(
  wb,
  "Group_Counts"
)
writeData(
  wb,
  "Group_Counts",
  group_counts
)
saveWorkbook(
  wb,
  file.path(
    out_dir,
    "FOLH1_ImmunePhenotype_PRAD.xlsx"
  ),
  overwrite = TRUE
)
