# ================================================================
# MTK26: IMMUNESIGDB DOWN ORA
# ================================================================

df <- as.data.frame(immune_down)

df <- df %>%
  arrange(p.adjust) %>%
  slice_head(n = 20)

# ------------------------------------------------
# FORCE EVERY DESCRIPTION TO EXACTLY TWO LINES
# ------------------------------------------------

df$Description_2line <- sapply(
  df$Description,
  function(x) {
    
    words <- strsplit(
      trimws(x),
      "\\s+"
    )[[1]]
    
    if (length(words) == 1) {
      n <- nchar(x)
      mid <- ceiling(n / 2)
      
      return(
        paste0(
          substr(x, 1, mid),
          "\n",
          substr(x, mid + 1, n)
        )
      )
    }
    
    txt <- paste(
      words,
      collapse = " "
    )
    
    total <- nchar(txt)
    
    cumulative <- cumsum(
      nchar(words)
    ) +
      seq_along(words) - 1
    
    possible <- seq_len(
      length(words) - 1
    )
    
    split_at <- possible[
      which.min(
        abs(
          cumulative[possible] -
            total / 2
        )
      )
    ]
    
    paste(
      paste(
        words[1:split_at],
        collapse = " "
      ),
      paste(
        words[(split_at + 1):length(words)],
        collapse = " "
      ),
      sep = "\n"
    )
  }
)

# ------------------------------------------------
# GENE RATIO
# ------------------------------------------------

df$GeneRatio_numeric <- sapply(
  df$GeneRatio,
  function(x) {
    
    parts <- strsplit(
      x,
      "/",
      fixed = TRUE
    )[[1]]
    
    as.numeric(parts[1]) /
      as.numeric(parts[2])
  }
)

# ------------------------------------------------
# SIGNIFICANCE
# ------------------------------------------------

df$minus_log10_padj <- -log10(
  pmax(
    df$p.adjust,
    .Machine$double.xmin
  )
)

# ------------------------------------------------
# ORDER Y AXIS
# ------------------------------------------------

df$Description_2line <- factor(
  df$Description_2line,
  levels = rev(
    df$Description_2line
  )
)

# ------------------------------------------------
# MAKE PLOT
# ------------------------------------------------

p <- ggplot(
  df,
  aes(
    x = GeneRatio_numeric,
    y = Description_2line,
    size = Count,
    colour = minus_log10_padj
  )
) +
  
  geom_point(
    alpha = 0.9
  ) +
  
  scale_colour_gradient(
    name = expression(
      -log[10]("adjusted P")
    )
  ) +
  
  scale_size_continuous(
    range = c(5, 13)
  ) +
  
  labs(
    title = paste0(
      "ImmuneSigDB ORA — Downregulated in treated (",
      plot_label,
      ")"
    ),
    x = "Gene ratio",
    y = NULL,
    size = "Gene count"
  ) +
  
  theme_nature(
    base_size = 18
  ) +
  
  theme(
    
    plot.title = element_text(
      face = "bold",
      hjust = 0.5,
      size = 24
    ),
    
    axis.title.x = element_text(
      face = "bold",
      size = 20
    ),
    
    axis.text.x = element_text(
      size = 17
    ),
    
    axis.text.y = element_text(
      size = 16,
      colour = "black",
      lineheight = 0.85
    ),
    
    legend.text = element_text(
      size = 15
    ),
    
    legend.title = element_text(
      face = "bold",
      size = 16
    ),
    
    plot.margin = margin(
      20,
      45,
      25,
      100
    )
  )

# ------------------------------------------------
# OUTPUT FILE
# ------------------------------------------------

plot_file <- file.path(
