plot_deg_heatmap <- function(
    gene_table,
    vst_mat,
    sample_info,
    file_name,
    title_text
){
  
  genes_use <- intersect(
    gene_table$ENSEMBL,
    rownames(vst_mat)
  )
  
  if(length(genes_use) < 2){
    
    message(
      "Skipping heatmap: fewer than 2 genes."
    )
    
    return(NULL)
  }
  
  hm_mat <- vst_mat[
    genes_use,
    ,
    drop = FALSE
  ]
  
  gene_symbols <- gene_table$SYMBOL[
    match(
      rownames(hm_mat),
      gene_table$ENSEMBL
    )
  ]
  
  gene_symbols[
    is.na(gene_symbols) |
      gene_symbols == ""
  ] <- rownames(hm_mat)[
    is.na(gene_symbols) |
      gene_symbols == ""
  ]
  
  rownames(hm_mat) <- make.unique(
    gene_symbols
  )
  
  annotation_col <- data.frame(
    
    Genotype =
      sample_info$genotype,
    
    Treatment =
      sample_info$treatment,
    
    Group =
      sample_info$Group4,
    
    row.names =
      rownames(sample_info)
  )
  
  annotation_colors <- list(
    
    Genotype = c(
      WT = "#0072B2",
      KO = "#D55E00"
    ),
    
    Treatment = c(
      Ctrl = "#4E79A7",
      MTK  = "#59A14F"
    ),
    
    Group = c(
      "WT-Ctrl" = "#1F77B4",
      "WT-MTK"  = "#2CA02C",
      "KO-Ctrl" = "#D62728",
      "KO-MTK"  = "#FF7F0E"
    )
  )
  
  pheatmap(
    
    hm_mat,
    
    scale = "row",
    
    annotation_col =
      annotation_col,
    
    annotation_colors =
      annotation_colors,
    
    cluster_rows = TRUE,
    
    cluster_cols = TRUE,
    
    clustering_method =
      "complete",
    
