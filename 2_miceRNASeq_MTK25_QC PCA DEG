# ============================================================
# PCA FUNCTION
# ============================================================

make_pca <- function(
    dds_object,
    groups,
    colours,
    title_text,
    output_file
){
  
  vst_tmp <- vst(
    dds_object,
    blind = TRUE
  )
  
  pca_obj <- prcomp(
    t(assay(vst_tmp)),
    center = TRUE,
    scale. = FALSE
  )
  
  percent_var <- round(
    100 * (
      pca_obj$sdev^2 /
        sum(pca_obj$sdev^2)
    ),
    1
  )
  
  pca_df <- data.frame(
    
    Sample =
      rownames(pca_obj$x),
    
    Group =
      as.character(groups),
    
    PC1 =
      pca_obj$x[,1],
    
    PC2 =
      pca_obj$x[,2]
    
  )
  
  # ----------------------------------------------------------
  # SAVE COORDINATES
  # ----------------------------------------------------------
  
  write.csv(
    
    pca_df,
    
    paste0(
      tools::file_path_sans_ext(output_file),
      "_coordinates.csv"
    ),
    
    row.names = FALSE
  )
  
  # ----------------------------------------------------------
  # SAVE EXPLAINED VARIANCE
  # ----------------------------------------------------------
  
  write.csv(
    
    data.frame(
      
      PC = paste0(
        "PC",
        seq_along(percent_var)
      ),
      
      Variance =
        percent_var
      
    ),
    
    paste0(
      tools::file_path_sans_ext(output_file),
      "_variance.csv"
    ),
    
    row.names = FALSE
  )
  
  # ----------------------------------------------------------
  # PLOT
  # ----------------------------------------------------------
  
  p <- ggplot(
    
    pca_df,
    
    aes(
      PC1,
      PC2,
      colour = Group,
      fill = Group
    )
    
  )
  
  # draw ellipses only if enough samples
  
  group_sizes <- table(
    pca_df$Group
  )
  
  if(all(group_sizes >= 3)){
    
    p <- p +
      
      stat_ellipse(
        
        aes(
          group = Group
        ),
        
        type = "t",
        
        geom = "polygon",
        
        alpha = 0.15,
        
        linewidth = 0.8
        
      )
  }
  
  p <- p +
    
    geom_point(
      size = 5
    ) +
    
    geom_text_repel(
      
      aes(
        label = Sample
      ),
      
      size = 3,
      
      max.overlaps = 100
    ) +
    
    scale_colour_manual(
      values = colours
    ) +
    
    scale_fill_manual(
      values = colours
    ) +
    
    theme_classic(
      base_size = 14
    ) +
    
    labs(
      
      title =
        title_text,
      
      x =
        paste0(
          "PC1 (",
          percent_var[1],
          "%)"
        ),
      
      y =
        paste0(
          "PC2 (",
          percent_var[2],
          "%)"
        )
      
    ) +
    
    theme(
      
      plot.title =
        element_text(
          face = "bold",
          hjust = 0.5
        ),
      
      legend.title =
        element_blank()
      
    )
  
  ggsave(
    
    output_file,
    
    p,
    
    width = 7.5,
    
    height = 6.5,
    
    dpi = 600
  )
  
  return(
    list(
      pca = pca_obj,
      data = pca_df,
      var = percent_var
    )
  )
}

