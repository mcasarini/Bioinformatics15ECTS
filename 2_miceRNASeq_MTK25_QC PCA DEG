# ============================================================
# DEG FUNCTION
# ============================================================

run_deg <- function(
    res,
    comparison_name,
    save_dir
){
  
  dir.create(
    save_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  res_df <- as.data.frame(res) %>%
    rownames_to_column("ENSEMBL")
  
  res_df <- left_join(
    res_df,
    anno,
    by = "ENSEMBL"
  )
  
  res_df <- res_df %>%
    
    arrange(
      padj,
      desc(abs(log2FoldChange))
    )
  
  # ----------------------------------------------------------
  # CLASSIFICATION
  # ----------------------------------------------------------
  
  res_df$Regulation <- case_when(
    
    !is.na(res_df$padj) &
      res_df$padj < 0.05 &
      res_df$log2FoldChange > 0.58 ~
      
      "Up",
    
    !is.na(res_df$padj) &
      res_df$padj < 0.05 &
      res_df$log2FoldChange < -0.58 ~
      
      "Down",
    
    TRUE ~
      
      "NS"
  )
  
  # ----------------------------------------------------------
  # SIGNIFICANT DEGS
  # ----------------------------------------------------------
  
  deg_sig <- res_df %>%
    
    filter(
      !is.na(padj),
      padj < 0.05,
      abs(log2FoldChange) > 0.58
    )
  
  # ----------------------------------------------------------
  # TOP 10
  # ----------------------------------------------------------
  
  deg_top10 <- res_df %>%
    
    filter(!is.na(padj)) %>%
    
    slice_head(
      n = 10
    )
  
  # ----------------------------------------------------------
  # TOP 50
  # ----------------------------------------------------------
  
  deg_top50 <- res_df %>%
    
    filter(!is.na(padj)) %>%
    
    slice_head(
      n = 50
    )
  
  # ----------------------------------------------------------
  # TOP 100
  # ----------------------------------------------------------
  
  deg_top100 <- res_df %>%
    
    filter(!is.na(padj)) %>%
    
    slice_head(
      n = 100
    )
  
  # ----------------------------------------------------------
  # SUMMARY
  # ----------------------------------------------------------
  
  summary_df <- data.frame(
    
    Comparison =
      comparison_name,
    
    Significant =
      nrow(deg_sig),
    
    Upregulated =
      sum(
        deg_sig$log2FoldChange > 0,
        na.rm = TRUE
      ),
    
    Downregulated =
      sum(
        deg_sig$log2FoldChange < 0,
        na.rm = TRUE
      ),
    
    stringsAsFactors = FALSE
  )
  
  # ----------------------------------------------------------
  # SAVE RESULTS
  # ----------------------------------------------------------
  
  write.csv(
    
    res_df,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_all_genes.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  write.csv(
    
    deg_sig,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_significant_DEGs.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  write.csv(
    
    deg_top10,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_Top10.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  write.csv(
    
    deg_top50,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_Top50.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  write.csv(
    
    deg_top100,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_Top100.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  write.csv(
    
    summary_df,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_summary.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  return(
    
    list(
      
      all =
        res_df,
      
      sig =
        deg_sig,
      
      top10 =
        deg_top10,
      
      top50 =
        deg_top50,
      
      top100 =
        deg_top100,
      
      summary =
        summary_df
    )
  )
}

