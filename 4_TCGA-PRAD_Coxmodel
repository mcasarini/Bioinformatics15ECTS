# Cox model analysis in TCGA-PRAD: Is FOLH1 expression linearly associated with hazard of death?

## setup
base_dir <- "C:/Users/Martina/Desktop/TCGA"
out_dir  <- file.path(base_dir, "results")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
setwd(base_dir)

## packages
library(SummarizedExperiment)
library(dplyr)
library(survival)
library(survminer)
library(ggplot2)
library(openxlsx)
library(splines)
library(showtext)
library(sysfonts)
font_add("Arial", "C:/Windows/Fonts/arial.ttf")
showtext_auto()

## load & check raw data
prad <- readRDS( file.path(base_dir, "TCGA_PRAD_clinical.rds") )
expr <- assay(prad, "fpkm_uq_unstrand")
rd <- as.data.frame(rowData(prad))
cd <- as.data.frame(colData(prad))
stopifnot(all(colnames(expr) == rownames(cd)))

## FOLH1 extraction
folh1_idx <- which(rd$gene_name == "FOLH1")
stopifnot(length(folh1_idx) > 0)
folh1 <- as.numeric(expr[folh1_idx[1], ])

## survival variables
OS_time <- ifelse(cd$vital_status == "Dead",
                  cd$days_to_death,
                  cd$days_to_last_follow_up)
OS_event <- ifelse(cd$vital_status == "Dead", 1, 0)

## build dataframe
df <- data.frame(
  FOLH1 = folh1,
  OS_time = as.numeric(OS_time),
  OS_event = OS_event,
  sample_type = cd$sample_type)
df <- df %>%
  filter(sample_type == "Primary Tumor") %>%
  filter(!is.na(FOLH1), !is.na(OS_time), !is.na(OS_event)) %>%
  filter(OS_time > 0)
df$logFOLH1 <- log2(df$FOLH1 + 1)
cat("Patients:", nrow(df), "\n")
cat("Deaths:", sum(df$OS_event), "\n")

## survival object
surv_obj <- Surv(df$OS_time, df$OS_event)

## linear Cox model & ph assumption test
cox_lin <- coxph(surv_obj ~ logFOLH1, data = df)
sum_lin <- summary(cox_lin)
hr   <- sum_lin$coefficients[,"exp(coef)"]
low  <- sum_lin$conf.int[,"lower .95"]
up   <- sum_lin$conf.int[,"upper .95"]
pval <- sum_lin$coefficients[,"Pr(>|z|)"]
cox_results <- data.frame(
  Variable = "FOLH1 (log2)",
  HR = hr,
  lower95 = low,
  upper95 = up,
  z = sum_lin$coefficients[,"z"],
  p_value = pval)
ph_test <- cox.zph(cox_lin)
ph_results <- as.data.frame(ph_test$table)
ph_results$variable <- rownames(ph_results)

## non-linear model (spinel)
cox_spline <- coxph(
  surv_obj ~ ns(logFOLH1, df = 3),
  data = df)
spline_comp <- anova(cox_lin, cox_spline)
print(spline_comp)

## martingale residual check
mart_res <- residuals(cox_lin, type = "martingale")
mart_df <- data.frame(
  logFOLH1 = df$logFOLH1,
  martingale = mart_res)
p_martingale <- ggplot(mart_df, aes(logFOLH1, martingale)) +
  geom_point(alpha = 0.5) +
  geom_smooth(method = "loess", se = TRUE) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  theme_bw() +
  labs(
    title = "Martingale residuals: linearity check",
    x = "log2(FOLH1 + 1)",
    y = "Residuals")
ggsave(
  file.path(out_dir, "6_TCGA-PRAD_FOLH1_martingalecheck.pdf"),
  p_martingale,
  width = 7,
  height = 5)

## forest plot
forest_df <- data.frame(
  Variable = "FOLH1 (log2)",
  HR = hr,
  lower = low,
  upper = up)
subtitle_text <- paste0(
  "HR=", round(hr,2),
  " (95% CI ", round(low,2), "-", round(up,2), ")",
  " | p=", signif(pval,3))
p_forest <- ggplot(forest_df, aes(x = Variable, y = HR)) +
  geom_point(size = 4) +
  geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.1) +
  geom_hline(yintercept = 1, linetype = "dashed") +
  scale_y_log10() +
  coord_flip() +
  theme_bw(base_size = 14) +
  labs(
    title = "TCGA-PRAD: Cox model (FOLH1)",
    subtitle = subtitle_text,
    x = "",
    y = "Hazard Ratio")
ggsave(
  file.path(out_dir, "6_TACGA-PRAD_FOLH1_forest.pdf"),
  p_forest,
  width = 7,
  height = 5)

## spline plot (hazard shape)
grid <- seq(min(df$logFOLH1), max(df$logFOLH1), length.out = 100)
pred_df <- data.frame(logFOLH1 = grid)
fit <- predict(cox_spline, newdata = pred_df, type = "lp", se.fit = TRUE)
pred_df$fit <- fit$fit
pred_df$upper <- fit$fit + 1.96 * fit$se.fit
pred_df$lower <- fit$fit - 1.96 * fit$se.fit
p_spline <- ggplot(pred_df, aes(logFOLH1, exp(fit))) +
  geom_line() +
  geom_ribbon(aes(ymin = exp(lower), ymax = exp(upper)), alpha = 0.2) +
  theme_bw() +
  labs(
    title = "Non-linear effect of FOLH1 on hazard (spline model)",
    x = "log2(FOLH1 + 1)",
    y = "Hazard Ratio (relative)")
ggsave(
  file.path(out_dir, "6_TCGA-PRAD_FOLH1_spline.pdf"),
  p_spline,
  width = 7,
  height = 5)

## summary
dataset_summary <- data.frame(
  n_patients = nrow(df),
  n_events = sum(df$OS_event),
  event_rate = round(mean(df$OS_event) * 100, 2),
  median_OS = median(df$OS_time),
  median_FOLH1 = median(df$FOLH1),
  median_logFOLH1 = median(df$logFOLH1))
wb <- createWorkbook()
addWorksheet(wb, "Summary")
writeData(wb, "Summary", dataset_summary)
addWorksheet(wb, "Cox_Linear")
writeData(wb, "Cox_Linear", cox_results)
addWorksheet(wb, "PH_Test")
writeData(wb, "PH_Test", ph_results)
addWorksheet(wb, "Spline_Comparison")
writeData(wb, "Spline_Comparison", spline_comp)
addWorksheet(wb, "Raw_Data")
writeData(wb, "Raw_Data", df)
saveWorkbook(
  wb,
  file.path(out_dir, "6_TCGA-PRAD_FOLH1_summary.xlsx"),
  overwrite = TRUE)
