## Which genes correlate with FOLH1? Spearman correlations
folh1 <- as.numeric(expr_norm_tumor["FOLH1", ])
gene_cor <- apply(expr_norm_tumor,1,
  function(x)
    cor(
      x,
      folh1,
      method = "spearman",
      use = "pairwise.complete.obs"))
gene_p <- apply(expr_norm_tumor, 1,
  function(x)
    cor.test(
      x,
      folh1,
      method = "spearman",
      exact = FALSE
    )$p.value)
cor_genes <- data.frame(Gene = rownames(expr_norm_tumor),rho = gene_cor,p_value = gene_p, stringsAsFactors = FALSE)
cor_genes$FDR <- p.adjust(cor_genes$p_value,method = "BH")
cor_genes <- cor_genes[cor_genes$Gene != "FOLH1",]
cor_genes <- cor_genes[order(-cor_genes$rho),]
sig_genes <- cor_genes %>% filter(FDR < 0.05 & abs(rho) > 0.30)
top_positive <- cor_genes %>%
  arrange(desc(rho)) %>%
  slice(1:100)
top_negative <- cor_genes %>%
  arrange(rho) %>%
  slice(1:100)

## Which pathways are associated with high FOLH1 expression? correlation coefficients as ranking metrik
ranks <- cor_genes$rho
names(ranks) <- cor_genes$Gene
ranks <- ranks[!is.na(ranks)]
ranks <- ranks[!duplicated(names(ranks))]
ranks <- sort(ranks,decreasing = TRUE)
hallmark <- msigdbr(species = "Homo sapiens",category = "H")
pathways <- split(hallmark$gene_symbol,hallmark$gs_name)
fgsea_res <- fgsea(
  pathways = pathways,
  stats = ranks,
  minSize = 15,
  maxSize = 500)
fgsea_res <- fgsea_res[order(fgsea_res$padj),]
fgsea_export <- as.data.frame(fgsea_res)
fgsea_export$leadingEdge <- sapply(
  fgsea_export$leadingEdge,
  paste,
  collapse = ";")
write.csv(fgsea_export,file.path(out_dir,"TCGA-PRAD_FOLH1_PathwaysCorrelation.csv"),row.names = FALSE)
fgsea_export[
  order(fgsea_export$padj),
  c("pathway","NES","padj")][1:20, ]

## What pathways differ between FOLH1-high and FOLH1-low tumors? use of Q25/Q75 cutoffs
folh1 <- as.numeric(expr_norm_tumor["FOLH1", ])
q25 <- quantile(folh1,0.25)
q75 <- quantile(folh1,0.75)
group <- rep(NA,length(folh1))
group[folh1 <= q25] <- "Low"
group[folh1 >= q75] <- "High"
keep <- !is.na(group)
expr_sub <- expr_norm_tumor[,keep]
group <- factor(
  group[keep],
  levels = c("Low","High"))
table(group)
folh1_groups <- data.frame(
  Sample = colnames(expr_sub),
  Group = group,
  FOLH1_VST = folh1[keep],
  stringsAsFactors = FALSE
)
write.csv(
  folh1_groups,
  file.path(
    out_dir,
    "FOLH1_HighLow_Samples.csv"
  ),
  row.names = FALSE
)
design <- model.matrix(~ group)
fit <- lmFit(expr_sub,design)
fit <- eBayes(fit)
deg <- topTable(
  fit,
  coef = 2,
  number = Inf,
  sort.by = "none")
deg$Gene <- rownames(deg)
write.csv(
  deg,
  file.path(
    out_dir,
    "FOLH1_High_vs_Low_DEGs.csv"
  ),
  row.names = FALSE
)
ranks <- deg$t
names(ranks) <- rownames(deg)
ranks <- ranks[!is.na(ranks)]
ranks <- ranks[!duplicated(names(ranks))]
ranks <- sort(
  ranks,
  decreasing = TRUE)
hallmark <- msigdbr(
  species = "Homo sapiens",
  category = "H"
)
pathways <- split(
  hallmark$gene_symbol,
  hallmark$gs_name
)
fgsea_group <- fgsea(
  pathways = pathways,
  stats = ranks,
  minSize = 15,
  maxSize = 500)
fgsea_group <- fgsea_group[
  order(fgsea_group$padj),]
fgsea_group_export <- as.data.frame(
  fgsea_group
)
fgsea_group_export$leadingEdge <- sapply(
  fgsea_group_export$leadingEdge,
  paste,
  collapse = ";"
)
