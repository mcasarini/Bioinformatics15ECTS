#FOLH1 vs top correlated gene scatterplots
gene <- "AR"
df <- data.frame(
  FOLH1 = expr_norm_tumor["FOLH1",],
  Gene = expr_norm_tumor[gene,])
cor_res <- cor.test(
  df$FOLH1,
  df$Gene,
  method = "spearman"
)
rho <- round(cor_res$estimate, 3)
pval <- signif(cor_res$p.value, 3)
p_scatter <- ggplot(
  df,
  aes(x = FOLH1, y = Gene)) +
  geom_point(
    size = 2.8,
    alpha = 0.75,
    color = "#2C7FB8") +
