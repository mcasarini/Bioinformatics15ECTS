run_biomarker_analysis <- function(
    deg_table,
    biomarkers,
    comparison_name,
    save_dir
){
  
  dir.create(
    save_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  biomarker_df <- deg_table %>%
    
    filter(
      !is.na(SYMBOL)
    ) %>%
    
    filter(
      toupper(SYMBOL) %in%
        toupper(biomarkers)
    ) %>%
    
    filter(
      !is.na(log2FoldChange)
    ) %>%
    
    mutate(
      
      Trend = case_when(
        
        !is.na(pvalue) &
          pvalue < 0.05 &
          log2FoldChange > 0 ~
          
          "Trend Up",
        
        !is.na(pvalue) &
          pvalue < 0.05 &
          log2FoldChange < 0 ~
          
          "Trend Down",
        
        TRUE ~
          
          "No Trend"
      )
    ) %>%
    
    arrange(
      pvalue
    )
  
  write.csv(
    
    biomarker_df,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_Biomarkers.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  trend_df <- biomarker_df %>%
    
    filter(
      Trend != "No Trend"
    )
  
  write.csv(
    
    trend_df,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_TrendGenes.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  ranked_df <- biomarker_df %>%
    
    select(
      SYMBOL,
      log2FoldChange,
      pvalue,
      padj,
      Trend
    ) %>%
    
    arrange(
      pvalue
    )
  
  write.csv(
    
    ranked_df,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_RankedBiomarkers.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  plot_df <- biomarker_df %>%
    
    mutate(
      
      Label = ifelse(
        
        Trend != "No Trend",
        
        paste0(
          
          SYMBOL,
          
          "\nFC=",
          
          round(
            log2FoldChange,
            2
          ),
          
          "\nFDR=",
          
          signif(
            padj,
            3
          )
        ),
        
        ""
      )
    )
  
  p <- ggplot(
    
    plot_df,
    
    aes(
      reorder(
        SYMBOL,
        log2FoldChange
      ),
      log2FoldChange,
      fill = Trend
    )
  ) +
    
    geom_col(
      width = 0.75
    ) +
    
    coord_flip() +
    
    geom_hline(
      yintercept = 0
    ) +
    
    scale_fill_manual(
      
      values = c(
        
        "Trend Up" = "#D62728",
        
        "Trend Down" = "#1F77B4",
        
        "No Trend" = "grey75"
      )
    ) +
    
    theme_classic(
      base_size = 14
    ) +
    
    theme(
      
      legend.title =
        element_blank(),
      
      plot.title =
        element_text(
          face = "bold",
          hjust = 0.5
        )
    ) +
    
    labs(
      
      title = comparison_name,
      
      subtitle =
        "Trend genes: p < 0.05",
      
      x = NULL,
      
      y = "log2 Fold Change"
    )
  
  ggsave(
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_Biomarker_Trends.png"
      )
    ),
    
    p,
    
    width = 8,
    
    height = 10,
    
    dpi = 300
  )
  
  summary_df <- data.frame(
    
    Comparison =
      comparison_name,
    
    Biomarkers =
      nrow(biomarker_df),
    
    TrendGenes =
      nrow(trend_df),
    
    TrendUp =
      sum(
        biomarker_df$Trend ==
          "Trend Up"
      ),
    
    TrendDown =
      sum(
        biomarker_df$Trend ==
          "Trend Down"
      )
  )
  
  write.csv(
    
    summary_df,
    
    file.path(
      save_dir,
      paste0(
        comparison_name,
        "_Summary.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  return(biomarker_df)
}

