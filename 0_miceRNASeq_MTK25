  )

treatment_df <- res_ko_df %>%
  
  select(
    ENSEMBL,
    SYMBOL,
    log2FoldChange,
    padj
  ) %>%
  
  rename(
    
    MTK_log2FC = log2FoldChange,
    
    MTK_FDR = padj
    
  )

rescue_df <- inner_join(
  
  disease_df,
  treatment_df,
  
  by = c(
    "ENSEMBL",
    "SYMBOL"
  )
  
) %>%
  
  filter(
    
    !is.na(Disease_log2FC),
    
    !is.na(MTK_log2FC)
    
  )

# ============================================================
# RESCUE METRICS
# ============================================================

rescue_df <- rescue_df %>%
  
  mutate(
    
    Opposite_Direction =
      
      sign(Disease_log2FC) !=
      sign(MTK_log2FC),
    
    Rescue_Percent = pmin(
      
      100,
      
      100 *
        
        abs(MTK_log2FC) /
        
        pmax(
          abs(Disease_log2FC),
          1e-6
        )
      
    ),
    
    Rescue_Score =
      
      -Disease_log2FC *
      MTK_log2FC,
    
    Rescue_Status = case_when(
      
      Opposite_Direction &
        Rescue_Percent >= 80 ~
        
        "Strong Rescue",
      
      Opposite_Direction &
        Rescue_Percent >= 50 ~
        
        "Partial Rescue",
      
      Opposite_Direction &
        Rescue_Percent >= 25 ~
        
        "Weak Rescue",
      
      TRUE ~
        
        "No Rescue"
      
    ),
    
    Quadrant = case_when(
      
      Disease_log2FC > 0 &
        MTK_log2FC < 0 ~
        
        "Rescued_Up",
      
      Disease_log2FC < 0 &
        MTK_log2FC > 0 ~
        
        "Rescued_Down",
      
      Disease_log2FC > 0 &
        MTK_log2FC > 0 ~
        
        "Concordant_Up",
      
      Disease_log2FC < 0 &
        MTK_log2FC < 0 ~
        
        "Concordant_Down",
      
      TRUE ~
        
        "Other"
      
    )
    
  )

# ============================================================
# STRICT RESCUE
# ============================================================

strict_rescue <- rescue_df %>%
  
  filter(
    
    Disease_FDR < 0.05,
    
    MTK_FDR < 0.05,
    
    abs(Disease_log2FC) > 0.58,
    
