# ============================================================

plot_deg_heatmap <- function(
    gene_table,
    vst_mat,
    sample_info,
    file_name,
    title_text
){
  
  genes_use <- intersect(
    gene_table$ENSEMBL,
    rownames(vst_mat)
  )
  
  if(length(genes_use) < 2){
    return(NULL)
  }
  
  hm_mat <- vst_mat[
    genes_use,
    ,
    drop = FALSE
  ]
  
  gene_symbols <- gene_table$SYMBOL[
    match(
      rownames(hm_mat),
      gene_table$ENSEMBL
    )
  ]
  
  gene_symbols[
    is.na(gene_symbols) |
      gene_symbols == ""
  ] <- rownames(hm_mat)
  
  rownames(hm_mat) <- make.unique(
    gene_symbols
  )
  
  ann_col <- data.frame(
    
    Genotype =
      sample_info$genotype,
    
    Treatment =
      sample_info$treatment,
    
    Group =
      sample_info$Group4,
    
    row.names =
      rownames(sample_info)
  )
  
  pheatmap(
    
    hm_mat,
    
    scale = "row",
    
    annotation_col =
      ann_col,
    
    cluster_rows = TRUE,
    
    cluster_cols = TRUE,
    
    border_color = NA,
    
    show_rownames = TRUE,
    
    main = title_text,
    
    filename = file_name,
    
