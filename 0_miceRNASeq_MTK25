count_terms <- function(x){
  
  if(is.null(x))
    return(0)
  
  df <- tryCatch(
    as.data.frame(x),
    error = function(e) NULL
  )
  
  if(is.null(df))
    return(0)
  
  nrow(df)
}

extract_top_term <- function(x){
  
  if(is.null(x))
    return(NA)
  
  df <- tryCatch(
    as.data.frame(x),
    error = function(e) NULL
  )
  
  if(is.null(df))
    return(NA)
  
  if(nrow(df) == 0)
    return(NA)
  
  df$Description[1]
}

