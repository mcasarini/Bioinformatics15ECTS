create_scatterplots <- function(
    corr_df,
    pink1_expr,
    expression_matrix,
    output_dir,
    condition_name = "All Samples"
){
  
  if(is.null(corr_df))
    return(NULL)
  
  dir.create(
    output_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  for(gene in corr_df$Gene){
    
    gene_expr <- as.numeric(
      expression_matrix[gene, ]
    )
    
    valid <- complete.cases(
      pink1_expr,
      gene_expr
    )
    
    if(sum(valid) < 3)
      next
    
    x <- pink1_expr[valid]
    y <- gene_expr[valid]
    
    corr_row <- corr_df %>%
      filter(Gene == gene)
    
    r_val <- round(
      corr_row$Pearson_R[1],
      3
    )
    
    p_val <- signif(
      corr_row$Pvalue[1],
      3
    )
    
    fdr_val <- signif(
      corr_row$FDR[1],
      3
    )
    
    sig_label <- corr_row$Significance[1]
    
    p <- ggplot(
      
      data.frame(
        PINK1 = x,
        Expression = y
      ),
      
      aes(
        PINK1,
        Expression
      )
      
    ) +
      
      geom_point(
        size = 3,
        color = "#2166AC"
      ) +
      
      geom_smooth(
        method = "lm",
        se = TRUE,
        color = "#B2182B"
      ) +
      
      annotate(
        
        "label",
        
        x = quantile(x, 0.05),
        
        y = quantile(y, 0.95),
        
        hjust = 0,
        
