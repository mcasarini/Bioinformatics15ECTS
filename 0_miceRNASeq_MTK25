# MITOCHONDRIAL RESCUE ANALYSIS
# ============================================================

mito_rescue <- mito_long %>%
  
  group_by(
    
    Signature,
    Condition
    
  ) %>%
  
  summarise(
    
    MeanScore = mean(
      Score,
      na.rm = TRUE
    ),
    
    SD = sd(
      Score,
      na.rm = TRUE
    ),
    
    .groups = "drop"
    
  ) %>%
  
  pivot_wider(
    
    names_from = Condition,
    
    values_from = c(
      MeanScore,
      SD
    )
    
  )

mito_rescue <- mito_rescue %>%
  
  mutate(
    
    KO_Effect =
      
      MeanScore_KO_Ctrl -
      
      MeanScore_WT_Ctrl,
    
    MTK_Effect =
      
      MeanScore_KO_MTK -
      
      MeanScore_KO_Ctrl,
    
    WT_MTK_Effect =
      
      MeanScore_WT_MTK -
      
      MeanScore_WT_Ctrl,
    
    Rescue_Magnitude =
      
      abs(KO_Effect) +
      
      abs(MTK_Effect),
    
    Rescue_Category = case_when(
      
      sign(KO_Effect) != sign(MTK_Effect) &
        abs(MTK_Effect) >= abs(KO_Effect) ~
        
        "Complete Rescue",
      
      sign(KO_Effect) != sign(MTK_Effect) &
        abs(MTK_Effect) >= abs(KO_Effect) * 0.50 ~
        
        "Partial Rescue",
      
      TRUE ~
        
        "No Rescue"
      
    )
    
  )

write.csv(
  
  mito_rescue,
  
  file.path(
    
    mito_dir,
    
    "Mitochondrial_Rescue.csv"
    
  ),
  
  row.names = FALSE
  
)

print(mito_rescue)
