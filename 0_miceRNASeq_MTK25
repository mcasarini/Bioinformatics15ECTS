# ============================================================
# RUN HALLMARK GSEA
# ============================================================

run_hallmark_gsea <- function(
    gene_table,
    comparison_name,
    output_dir
){
  
  ranked_genes <- gene_table %>%
    
    filter(
      !is.na(ENTREZID)
    ) %>%
    
    filter(
      !is.na(log2FoldChange)
    ) %>%
    
    group_by(
      ENTREZID
    ) %>%
    
    slice(1) %>%
    
    ungroup()
  
  gene_list <- ranked_genes$log2FoldChange
  
  names(gene_list) <-
    ranked_genes$ENTREZID
  
  gene_list <- sort(
    gene_list,
    decreasing = TRUE
  )
  
  gsea_res <- GSEA(
    
    geneList = gene_list,
    
    TERM2GENE = hallmark_sets,
    
    pvalueCutoff = 0.05,
    
    verbose = FALSE
  )
  
  if(
    is.null(gsea_res) ||
    nrow(as.data.frame(gsea_res)) == 0
  ){
    
    message(
      comparison_name,
      ": no Hallmark enrichment"
    )
    
    return(NULL)
  }
  
  gsea_df <- as.data.frame(
    gsea_res
  )
  
  write.csv(
    
    gsea_df,
    
    file.path(
      
      output_dir,
      
      paste0(
        comparison_name,
        "_Hallmark_GSEA.csv"
      )
      
    ),
    
    row.names = FALSE
  )
  
  # ---------------------------------------------------------
  # DOTPLOT
  # ---------------------------------------------------------
  
  p1 <- dotplot(
    
    gsea_res,
    
    showCategory = 20
    
  ) +
    
    ggtitle(
      
      paste0(
        comparison_name,
        " Hallmark GSEA"
      )
      
    )
  
  ggsave(
    
    file.path(
      
      output_dir,
      
      paste0(
        comparison_name,
        "_Hallmark_dotplot.png"
      )
      
    ),
    
    p1,
    
    width = 10,
    
    height = 8,
    
    dpi = 300
  )
  
  # ---------------------------------------------------------
  # RIDGEPLOT
  # ---------------------------------------------------------
  
  p2 <- ridgeplot(
    gsea_res
  )
  
  ggsave(
    
    file.path(
      
      output_dir,
      
      paste0(
        comparison_name,
        "_Hallmark_ridgeplot.png"
      )
      
    ),
    
    p2,
    
    width = 12,
    
    height = 8,
    
    dpi = 300
  )
  
  return(gsea_res)
}

