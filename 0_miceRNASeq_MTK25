# ============================================================
# CORRELATION ENGINE
# ============================================================

calculate_correlations <- function(
    pink1_expr,
    expression_matrix,
    genes
){
  
  results <- lapply(
    
    genes,
    
    function(gene){
      
      gene_expr <- as.numeric(
        expression_matrix[gene, ]
      )
      
      valid <- complete.cases(
        pink1_expr,
        gene_expr
      )
      
      if(sum(valid) < 3){
        
        return(NULL)
        
      }
      
      x <- pink1_expr[valid]
      y <- gene_expr[valid]
      
      if(sd(x) == 0 || sd(y) == 0){
        
        return(NULL)
        
      }
      
      ct <- tryCatch(
        
        cor.test(
          x,
          y,
          method = "pearson"
        ),
        
        error = function(e) NULL
        
      )
      
      if(is.null(ct))
        return(NULL)
      
      data.frame(
        
        Gene = gene,
        
        Pearson_R =
          unname(ct$estimate),
        
        Pvalue =
          ct$p.value,
        
        N = length(x),
        
        stringsAsFactors = FALSE
        
      )
      
    }
    
  )
  
  results <- Filter(
    Negate(is.null),
    results
  )
  
  if(length(results) == 0){
    
    return(NULL)
    
  }
  
  bind_rows(results) %>%
    
    mutate(
      
      FDR =
        p.adjust(
          Pvalue,
          method = "BH"
        ),
      
      Significance = case_when(
        
        FDR < 0.001 ~ "***",
        
        FDR < 0.01 ~ "**",
        
        FDR < 0.05 ~ "*",
        
        TRUE ~ "ns"
        
      )
      
    ) %>%
    
    arrange(
      desc(abs(Pearson_R))
    )
  
}

