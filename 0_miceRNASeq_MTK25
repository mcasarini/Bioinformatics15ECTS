run_go_bp <- function(
    gene_table,
    comparison_name,
    output_dir
){
  
  sig_genes <- gene_table %>%
    
    filter(
      !is.na(ENTREZID)
    ) %>%
    
    filter(
      !is.na(padj)
    ) %>%
    
    filter(
      padj < 0.05
    ) %>%
    
    distinct(
      ENTREZID,
      .keep_all = TRUE
    )
  
  if(nrow(sig_genes) < 10){
    
    message(
      comparison_name,
      ": fewer than 10 significant genes."
    )
    
    return(NULL)
  }
  
  ego <- enrichGO(
    
    gene =
      sig_genes$ENTREZID,
    
    OrgDb =
      org.Mm.eg.db,
    
    keyType =
      "ENTREZID",
    
    ont =
      "BP",
    
    pAdjustMethod =
      "BH",
    
    pvalueCutoff =
      0.05,
    
    qvalueCutoff =
      0.05,
    
    readable =
      TRUE
  )
  
  if(is.null(ego) || nrow(as.data.frame(ego)) == 0){
    
    message(
      comparison_name,
      ": no enriched GO terms."
    )
    
    return(NULL)
  }
  
  go_df <- as.data.frame(
    ego
  )
  
  write.csv(
    
    go_df,
    
    file.path(
      
      output_dir,
      
      paste0(
        comparison_name,
        "_GO_BP.csv"
      )
      
    ),
    
    row.names = FALSE
  )
  
  p <- dotplot(
    
    ego,
    
    showCategory = 20,
    
    font.size = 10
    
  ) +
    
    ggtitle(
      
      paste0(
        comparison_name,
        " GO Biological Process"
      )
      
    )
  
  ggsave(
    
    file.path(
      
      output_dir,
      
      paste0(
        comparison_name,
        "_GO_BP_dotplot.png"
      )
      
    ),
    
    p,
    
    width = 10,
    
    height = 8,
    
    dpi = 300
  )
  
  return(
    ego
  )
}

