# ============================================================
# DISEASE AND TREATMENT SIGNATURES
# ============================================================

disease_df <- res_ctrl_df %>%
  
  select(
    ENSEMBL,
    SYMBOL,
    log2FoldChange,
    padj
  ) %>%
  
  rename(
    
    Disease_log2FC = log2FoldChange,
    
