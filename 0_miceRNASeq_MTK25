# ============================================================
# TREND BOXPLOTS
# ============================================================

run_biomarker_trend <- function(
    deg_table,
    biomarkers,
    comparison_name,
    output_dir
){
  
  dir.create(
    output_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  biomarker_df <- deg_table %>%
    
    filter(
      !is.na(SYMBOL)
    ) %>%
    
    filter(
      toupper(SYMBOL) %in%
        toupper(biomarkers)
    ) %>%
    
    filter(
      !is.na(log2FoldChange)
    ) %>%
    
    mutate(
      
      Trend = case_when(
        
        !is.na(padj) &
          padj < 0.05 &
          log2FoldChange > 0 ~
          
          "Higher",
        
        !is.na(padj) &
          padj < 0.05 &
          log2FoldChange < 0 ~
          
          "Lower",
        
        TRUE ~
          
          "No Trend"
      )
    ) %>%
    
    arrange(
      padj
    )
  
  # ==========================================================
  # EXPORT TABLES
  # ==========================================================
  
  write.csv(
    
    biomarker_df,
    
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Biomarkers.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  trend_only <- biomarker_df %>%
    
    filter(
      Trend != "No Trend"
    )
  
  write.csv(
    
    trend_only,
    
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Trend_Genes.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  # ==========================================================
  # BARPLOT
  # ==========================================================
  
  plot_df <- biomarker_df %>%
    
    mutate(
      
      Label = ifelse(
        
        !is.na(padj) &
          padj < 0.05,
        
        paste0(
          "FDR=",
          signif(
            padj,
            2
          )
        ),
        
        ""
      )
    )
  
  p_bar <- ggplot(
    plot_df,
    aes(
      x = reorder(SYMBOL, log2FoldChange),
      y = log2FoldChange,
      fill = Trend
    )
  ) +
    
    geom_col(width = 0.75) +
    
    geom_text(
      aes(label = Label),
      hjust = ifelse(
        plot_df$log2FoldChange > 0,
        -0.1,
        1.1
      ),
      size = 3
    ) +
    
    coord_flip(clip = "off") +
    
    geom_hline(yintercept = 0) +
    
    scale_fill_manual(
      values = c(
        Higher = "#D62728",
        Lower = "#1F77B4",
        `No Trend` = "grey75"
      )
    ) +
    
    scale_y_continuous(
      expand = expansion(
        mult = c(0.15, 0.35)
      )
    ) +
    
    theme_classic() +
    
    labs(
      title = paste0(
        comparison_name,
        " Biomarker Trends"
      ),
      x = NULL,
      y = "log2 Fold Change"
    ) +
    
    theme(
      legend.title = element_blank(),
      legend.position = "bottom",
      plot.title = element_text(
        hjust = 0.5,
        face = "bold"
      ),
      plot.margin = margin(
        t = 20,
        r = 80,
        b = 20,
        l = 20
      )
    )
  
  plot_height <- max(
    8,
    nrow(plot_df) * 0.35
  )
  
  ggsave(
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Biomarker_Trends.png"
      )
    ),
    p_bar,
    width = 12,
    height = plot_height,
    dpi = 300,
    limitsize = FALSE
  )
  
  # ==========================================================
  # SCATTERPLOT
  # ==========================================================
  
  p_scatter <- ggplot(
    
    biomarker_df,
    
    aes(
      
      log2FoldChange,
      
      -log10(
        pmax(
          pvalue,
          1e-300
        )
      )
    )
    
  ) +
    
    geom_point(
      
      aes(
        colour = Trend
      ),
      
      size = 3
    ) +
    
    geom_hline(
      
      yintercept = -log10(0.05),
      
      linetype = 2
    ) +
  
  geom_text_repel(
    
    data = subset(
      plot_df,
      Trend != "No Trend"
    ),
    
    aes(
      label = paste0(
        SYMBOL,
        "\nlog2FC=",
        round(log2FoldChange, 2),
        "\nFDR=",
        ifelse(
          is.na(padj),
          "NA",
          signif(padj, 3)
        )
      )
    ),
    
    size = 3,
    
    direction = "y",
    
    box.padding = 0.5,
    
    point.padding = 0.3,
    
    segment.color = "grey50",
    
    max.overlaps = Inf
  ) +
    
    scale_colour_manual(
      
      values = c(
        
        Higher = "#D62728",
        
        Lower = "#1F77B4",
        
        `No Trend` = "grey70"
      )
    ) +
    
    scale_y_continuous(
      
      expand = expansion(
        mult = c(
          0.05,
          0.30
        )
      )
    ) +
    
    theme_classic() +
    
    labs(
      
      title = paste0(
        comparison_name,
        " Biomarker Trends"
      ),
      
      x = "log2 Fold Change",
      
      y = "-log10(p-value)"
    )
  
  ggsave(
    
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Biomarker_Trends_Scatter.png"
      )
    ),
    
    p_scatter,
    
    width = 10,
    
    height = 7,
    
    dpi = 300
  )
  
  # ==========================================================
  # SUMMARY
  # ==========================================================
  
  summary_df <- data.frame(
    
    Comparison =
      comparison_name,
    
    Tested =
      nrow(biomarker_df),
    
    Significant =
      sum(
        biomarker_df$padj < 0.05,
        na.rm = TRUE
      ),
    
    Higher =
      sum(
        biomarker_df$Trend == "Higher"
      ),
    
    Lower =
      sum(
        biomarker_df$Trend == "Lower"
      )
  )
  
  write.csv(
    
    summary_df,
    
    file.path(
      output_dir,
      paste0(
        comparison_name,
        "_Summary.csv"
      )
    ),
    
    row.names = FALSE
  )
  
  return(
    biomarker_df
  )
  
}

